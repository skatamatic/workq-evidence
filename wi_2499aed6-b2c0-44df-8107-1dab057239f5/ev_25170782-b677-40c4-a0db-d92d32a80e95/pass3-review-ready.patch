new file mode 100644
index 0000000..8f9bcac
--- /dev/null
+++ b/insight-service/src/main/java/com/flatirons/insight/service/runtime/WorkflowNotificationOutboxService.java
@@ -0,0 +1,83 @@
+/** Copyright (c) 2026, Flatirons Solutions. All Rights Reserved. */
+package com.flatirons.insight.service.runtime;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.SerializationFeature;
+import com.flatirons.insight.repository.WorkflowNotificationOutboxRepository;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Qualifier;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.TransactionDefinition;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.transaction.support.TransactionSynchronization;
+import org.springframework.transaction.support.TransactionSynchronizationManager;
+import org.springframework.transaction.support.TransactionTemplate;
+
+/** PostgreSQL durable at-least-once delivery. SMTP acceptance followed by a crash can duplicate delivery. */
+@Service
+public class WorkflowNotificationOutboxService implements WorkflowNotificationOutbox, WorkflowNotificationDelivery {
+    private static final Logger LOG = LoggerFactory.getLogger(WorkflowNotificationOutboxService.class);
+    private final WorkflowNotificationOutboxRepository events;
+    private final WorkflowMailService mail;
+    private final ObjectMapper mapper;
+    private final TransactionTemplate deliveryTransaction;
+
+    public WorkflowNotificationOutboxService(WorkflowNotificationOutboxRepository events, WorkflowMailService mail,
+            ObjectMapper mapper, @Qualifier("insightTransactionManager") PlatformTransactionManager transactions) {
+        this.events=events; this.mail=mail;
+        this.mapper=mapper.copy().enable(SerializationFeature.ORDER_MAP_ENTRIES_BY_KEYS);
+        deliveryTransaction=new TransactionTemplate(transactions);
+        deliveryTransaction.setPropagationBehavior(TransactionDefinition.PROPAGATION_REQUIRES_NEW);
+    }
+
+    @Override
+    @Transactional(transactionManager="insightTransactionManager", propagation=org.springframework.transaction.annotation.Propagation.MANDATORY)
+    public void enqueue(String eventKey, WorkflowMailService.Request request) {
+        if (eventKey == null || eventKey.isBlank() || eventKey.length()>255) {
+            throw new IllegalArgumentException("Invalid notification event identity");
+        }
+        if (!TransactionSynchronizationManager.isActualTransactionActive()
+                || !TransactionSynchronizationManager.isSynchronizationActive()) {
+            throw new IllegalStateException("Notification enqueue requires the workflow transaction");
+        }
+        mail.validate(request);
+        String payload;
+        try { payload=mapper.writeValueAsString(request); }
+        catch (com.fasterxml.jackson.core.JsonProcessingException failure) {
+            throw new IllegalArgumentException("Invalid notification payload", failure);
+        }
+        events.insertIfAbsent(eventKey, payload);
+        var event=events.findById(eventKey).orElseThrow();
+        if (!payload.equals(event.getPayload())) { throw new IllegalArgumentException("Conflicting notification event payload"); }
+        TransactionSynchronizationManager.registerSynchronization(new TransactionSynchronization() {
+            @Override public void afterCommit() { dispatch(eventKey); }
+        });
+    }
+
+    /** Independent transaction and row lock serialize dispatchers; committed sent rows never send again. */
+    public void dispatch(String eventKey) {
+        try {
+            deliveryTransaction.executeWithoutResult(status -> events.lockEvent(eventKey).ifPresent(event -> {
+                if (event.isDelivered()) { return; }
+                event.attempted(java.time.Instant.now().plusSeconds(30));
+                try {
+                    var request=mapper.readValue(event.getPayload(), WorkflowMailService.Request.class);
+                    mail.send(request);
+                    event.delivered();
+                } catch (Exception failure) {
+                    // Keep this durable row pending. Do not tell a caller to retry a committed process start.
+                    LOG.warn("Workflow notification {} remains pending after attempt {}", eventKey, event.getAttempts(), failure);
+                }
+            }));
+        } catch (RuntimeException failure) {
+            // Transaction/storage failure also leaves the committed event eligible for retry.
+            LOG.warn("Workflow notification dispatch transaction failed for {}", eventKey, failure);
+        }
+    }
+
+    public void retryUnsent() {
+        events.findTop50ByDeliveredFalseAndNextAttemptAtLessThanEqualOrderByNextAttemptAtAscEventKeyAsc(java.time.Instant.now()).forEach(event -> dispatch(event.getEventKey()));
+    }
+}
