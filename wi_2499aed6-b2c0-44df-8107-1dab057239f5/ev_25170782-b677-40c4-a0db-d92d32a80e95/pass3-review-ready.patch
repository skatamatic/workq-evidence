+            scheduler=context.getBean("workflowNotificationRetryScheduler",ThreadPoolTaskScheduler.class);
+            assertThat(retry.await(2,TimeUnit.SECONDS)).isTrue();
+            assertThat(context.getBeansOfType(ScheduledAnnotationBeanPostProcessor.class)).isEmpty();
+            assertThat(unrelated.calls).hasValue(0);
+        }
+        assertThat(scheduler.getScheduledThreadPoolExecutor().isShutdown()).isTrue();
+    }
+    @Test void invalidDelayFailsBeforeScheduling() {
+        try (var context=new AnnotationConfigApplicationContext()) {
+            context.getEnvironment().getPropertySources().addFirst(new MapPropertySource("test",Map.of("insight.workflow.mail.retry-delay-ms",0)));
+            context.registerBean(WorkflowNotificationDelivery.class,() -> mock(WorkflowNotificationDelivery.class));
+            context.register(WorkflowNotificationDeliveryConfiguration.class);
+            assertThatThrownBy(context::refresh).hasStackTraceContaining("retry delay must be positive");
+        }
+    }
+}
