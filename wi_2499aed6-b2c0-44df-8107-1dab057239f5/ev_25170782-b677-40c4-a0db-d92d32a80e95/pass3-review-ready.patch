@@ -0,0 +1,36 @@
+/** Copyright (c) 2026, Flatirons Solutions. All Rights Reserved. */
+package com.flatirons.insight.service.runtime;
+
+import java.time.Duration;
+import java.time.Instant;
+import org.springframework.beans.factory.SmartInitializingSingleton;
+import org.springframework.beans.factory.annotation.Qualifier;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler;
+
+/** Registers only outbox retries; does not enable annotation scheduling for unrelated jobs. */
+@Configuration(proxyBeanMethods=false)
+public class WorkflowNotificationDeliveryConfiguration {
+    private WorkflowNotificationDeliveryConfiguration() { }
+
+    @Bean(name="workflowNotificationRetryScheduler", destroyMethod="shutdown")
+    ThreadPoolTaskScheduler workflowNotificationRetryScheduler() {
+        var scheduler=new ThreadPoolTaskScheduler();
+        scheduler.setPoolSize(1);
+        scheduler.setThreadNamePrefix("workflow-notification-retry-");
+        scheduler.setRemoveOnCancelPolicy(true);
+        return scheduler;
+    }
+
+    @Bean
+    SmartInitializingSingleton workflowNotificationRetryRegistration(
+            @Qualifier("workflowNotificationRetryScheduler") ThreadPoolTaskScheduler scheduler,
+            WorkflowNotificationDelivery delivery,
+            @Value("${insight.workflow.mail.retry-delay-ms:30000}") long delayMillis) {
+        if (delayMillis<=0) { throw new IllegalArgumentException("Notification retry delay must be positive"); }
+        return () -> scheduler.scheduleWithFixedDelay(delivery::retryUnsent,
+                Instant.now().plusMillis(delayMillis), Duration.ofMillis(delayMillis));
+    }
+}
