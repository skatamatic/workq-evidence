+/** Copyright (c) 2026, Flatirons Solutions. All Rights Reserved. */
+package com.flatirons.insight.domain;
+import jakarta.persistence.*;
+@Entity
+@Table(name="workflow_notification_outbox")
+public class WorkflowNotificationOutboxEntity {
+    @Id @Column(name="event_key", length=255) private String eventKey;
+    @Column(nullable=false, columnDefinition="text") private String payload;
+    @Column(nullable=false) private boolean delivered;
+    @Column(nullable=false) private int attempts;
+    @Column(name="next_attempt_at", nullable=false) private java.time.Instant nextAttemptAt;
+    public String getEventKey() { return eventKey; }
+    public String getPayload() { return payload; }
+    public boolean isDelivered() { return delivered; }
+    public int getAttempts() { return attempts; }
+    public java.time.Instant getNextAttemptAt() { return nextAttemptAt; }
+    public void attempted(java.time.Instant next) { attempts++; nextAttemptAt=next; }
+    public void delivered() { delivered=true; }
+}
