diff --git a/insight-service/src/main/java/com/flatirons/insight/service/runtime/WorkflowNotificationDeliveryConfiguration.java b/insight-service/src/main/java/com/flatirons/insight/service/runtime/WorkflowNotificationDeliveryConfiguration.java
