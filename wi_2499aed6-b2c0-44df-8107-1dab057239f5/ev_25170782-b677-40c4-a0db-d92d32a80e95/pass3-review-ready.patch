+/** Copyright (c) 2026, Flatirons Solutions. All Rights Reserved. */
+package com.flatirons.insight.service.runtime;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.flatirons.insight.domain.WorkflowNotificationOutboxEntity;
+import com.flatirons.insight.repository.WorkflowNotificationOutboxRepository;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.NullAndEmptySource;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.TransactionStatus;
+import org.springframework.transaction.support.TransactionSynchronizationManager;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import static org.mockito.Mockito.*;
+import static org.assertj.core.api.Assertions.*;
+
+class WorkflowNotificationOutboxServiceTest {
+    private final WorkflowNotificationOutboxRepository events=mock(WorkflowNotificationOutboxRepository.class);
+    private final WorkflowMailService mail=mock(WorkflowMailService.class);
+    private final PlatformTransactionManager transactions=mock(PlatformTransactionManager.class);
+    private final WorkflowNotificationOutboxService service=new WorkflowNotificationOutboxService(events,mail,new ObjectMapper(),transactions);
+    private WorkflowMailService.Request request(Map<String,Object> variables) {
+        return new WorkflowMailService.Request("template.ftl","from@example.invalid",List.of("to@example.invalid"),
+                List.of(),List.of(),"Received",variables);
+    }
+    @AfterEach void clearTransaction() {
+        if (TransactionSynchronizationManager.isSynchronizationActive()) { TransactionSynchronizationManager.clearSynchronization(); }
+        TransactionSynchronizationManager.setActualTransactionActive(false);
+    }
+    @ParameterizedTest @NullAndEmptySource @ValueSource(strings={" ","overlong"})
+    void invalidEventIdentityCannotPersist(String key) {
+        String eventKey="overlong".equals(key) ? "x".repeat(256) : key;
+        var payload=request(Map.of());
+        assertThatThrownBy(() -> service.enqueue(eventKey,payload)).isInstanceOf(IllegalArgumentException.class);
+        verifyNoInteractions(events,mail);
+    }
+    @Test void enqueueRequiresActiveWorkflowTransactionAndSynchronization() {
+        var payload=request(Map.of());
+        assertThatThrownBy(() -> service.enqueue("process/activity/start",payload)).hasMessageContaining("workflow transaction");
+        TransactionSynchronizationManager.setActualTransactionActive(true);
+        assertThatThrownBy(() -> service.enqueue("process/activity/start",payload)).hasMessageContaining("workflow transaction");
+        verifyNoInteractions(events,mail);
+    }
+    @Test void unserializablePayloadRefusesBeforePersistence() {
+        TransactionSynchronizationManager.setActualTransactionActive(true);
+        TransactionSynchronizationManager.initSynchronization();
+        var payload=request(Map.of("unsupported",new Object()));
+        assertThatThrownBy(() -> service.enqueue("process/activity/start",payload)).hasMessageContaining("Invalid notification payload");
+        verifyNoInteractions(events);
+    }
+    @Test void storageFailureDuringDispatchNeverCallsTransport() {
+        when(transactions.getTransaction(any())).thenThrow(new IllegalStateException("Unavailable database"));
+        service.dispatch("process/activity/start");
+        verifyNoInteractions(events,mail);
+    }
+    @Test void absentAndCorruptRowsCannotDeliver() {
+        when(transactions.getTransaction(any())).thenReturn(mock(TransactionStatus.class));
+        when(events.lockEvent("absent")).thenReturn(Optional.empty());
+        var corrupt=mock(WorkflowNotificationOutboxEntity.class);
+        when(corrupt.getPayload()).thenReturn("{broken"); when(events.lockEvent("corrupt")).thenReturn(Optional.of(corrupt));
+        service.dispatch("absent"); service.dispatch("corrupt");
+        verify(corrupt).attempted(any()); verify(corrupt,never()).delivered(); verifyNoInteractions(mail);
+    }
+    @Test void unsupportedTransportPreflightFailsClosed() {
+        WorkflowMailService unsupported=delivery -> { throw new AssertionError("Must not send"); };
+        var payload=request(Map.of());
+        assertThatThrownBy(() -> unsupported.validate(payload)).hasMessageContaining("preflight validation");
+    }
+}
