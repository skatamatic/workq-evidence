+                com.flatirons.insight.repository.GroupRepository.class, com.flatirons.insight.repository.ReferenceDataLookupRepository.class}), transactionManagerRef = "insightTransactionManager")
+@Import({WorkflowIdentifierConfiguration.class, InsightSequenceService.class,
+        InsightProcessIdGenService.class, InsightSequenceListener.class, InsightProcessIdGenListener.class,
+        WorkflowProcessNamingConfiguration.class, InsightRenameProcessListener.class, InsightSetBusinessKeyListener.class, WorkflowTaskRoutingService.class,
+        com.flatirons.insight.service.runtime.listener.InsightLdapListener.class,
+        com.flatirons.insight.service.runtime.listener.InsightJsonUtilListener.class,
+        com.flatirons.insight.service.runtime.listener.FlowConditionsBean.class,
