+/**
+ * Copyright (c) 2026, Flatirons Solutions. All Rights Reserved.
+ * This code may not be used without the express written permission
+ * of the copyright holder, Flatirons Solutions.
+ */
+package com.flatirons.insight.service.runtime;
+
+import java.util.Set;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.flatirons.insight.domain.ReferenceDataLookupEntity;
+import com.flatirons.insight.domain.GroupEntity;
+import com.flatirons.insight.model.enums.status.GroupStatus;
+import com.flatirons.insight.model.enums.type.GroupType;
+import com.flatirons.insight.repository.ReferenceDataLookupRepository;
+import com.flatirons.insight.repository.GroupRepository;
+import org.flowable.engine.RepositoryService;
+import org.flowable.engine.RuntimeService;
+import org.flowable.task.service.delegate.DelegateTask;
+import org.flowable.identitylink.api.IdentityLinkType;
+import org.springframework.context.annotation.Lazy;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/** Bounded persisted exact-key lookup, distinct from group resolution. No Administration table emulation. */
+@Service
+public class WorkflowTaskRoutingService {
+    private static final String RULE_TYPE = "workflow-task-routing";
+    private final ReferenceDataLookupRepository lookups;
+    private final GroupRepository groups;
+    private final RepositoryService repository;
+    private final RuntimeService runtime;
+    private final ObjectMapper mapper;
+
+    public WorkflowTaskRoutingService(ReferenceDataLookupRepository lookups, GroupRepository groups,
+            @Lazy RepositoryService repository, @Lazy RuntimeService runtime, ObjectMapper mapper) {
+        this.lookups = lookups;
+        this.groups = groups;
+        this.repository = repository;
+        this.runtime = runtime;
+        this.mapper = mapper;
+    }
+
+    private JsonNode rule(DelegateTask task) {
+        if (task.getTenantId() != null && !task.getTenantId().isEmpty()) {
+            throw new IllegalArgumentException("Tenant routing is not supported at " + task.getTaskDefinitionKey());
+        }
+        String process = repository.getProcessDefinition(task.getProcessDefinitionId()).getKey();
+        String taskKey = task.getTaskDefinitionKey();
+        if (!"SafranFeedbackWorkflow".equals(process) || !"local-review-feedback".equals(taskKey)) {
+            throw new IllegalArgumentException("Unsupported routing at " + process + "/" + taskKey);
+        }
+        JsonNode rule = record(RULE_TYPE, process + "/" + taskKey);
+        if (!process.equals(text(rule, "processKey")) || !taskKey.equals(text(rule, "taskKey"))) {
+            throw new IllegalArgumentException("Routing rule process/task mismatch at " + taskKey);
+        }
+        return rule;
+    }
+
+    @Transactional(transactionManager = "insightTransactionManager")
+    public void rename(DelegateTask task) {
+        // Administration supplies the display name explicitly; no bundled customer naming configuration.
+        String name = text(rule(task), "taskName");
+        if (name.length() > 255) { throw new IllegalArgumentException("Routing task name exceeds 255 characters"); }
+        task.setName(name);
+    }
+
+    @Transactional(transactionManager = "insightTransactionManager")
+    public void assign(DelegateTask task, boolean involve) {
+        JsonNode rule = rule(task);
+        String variable = text(rule, "lookupVariable");
+        if (!"submitting_site".equals(variable)) {
+            throw new IllegalArgumentException("Unsupported routing variable " + variable);
+        }
+        Object value = task.getVariable(variable);
+        if (!(value instanceof String key) || key.isBlank() || key.length() > 255) {
+            throw new IllegalArgumentException("Missing routing lookup value at " + task.getTaskDefinitionKey());
+        }
+        String lookupType = text(rule, "lookupType");
+        if (RULE_TYPE.equals(lookupType)) { throw new IllegalArgumentException("Routing lookup cannot select a rule"); }
+        JsonNode match = record(lookupType, key);
+        String groupName = text(match, "candidateGroup");
+        GroupEntity group = groups.findByNameAndGroupType(groupName, GroupType.GROUP)
+                .orElseThrow(() -> new IllegalArgumentException("Unresolved routing group " + groupName));
+        if (group.getId() == null || group.getStatus() != GroupStatus.ACTIVE) {
+            throw new IllegalArgumentException("Inactive routing group " + groupName);
+        }
+        String groupId = group.getId().toString();
+        // Resolve everything before touching assignment. The Flowable command and JPA share one transaction.
+        for (var link : Set.copyOf(task.getCandidates())) {
+            if (link.getGroupId() != null) { task.deleteCandidateGroup(link.getGroupId()); }
+            if (link.getUserId() != null) { task.deleteCandidateUser(link.getUserId()); }
+        }
+        task.addCandidateGroup(groupId);
+        task.setVariable("candidate_group", groupId);
+        if (involve) {
+            task.addGroupIdentityLink(groupId, IdentityLinkType.PARTICIPANT);
+            runtime.addParticipantGroup(task.getProcessInstanceId(), groupId);
+        }
+    }
+
+    private JsonNode record(String type, String key) {
+        ReferenceDataLookupEntity entity = lookups.findByLookupTypeAndKeyValue(type, key)
+                .orElseThrow(() -> new IllegalArgumentException("Missing routing lookup " + type + "/" + key));
+        if (!Boolean.FALSE.equals(entity.getIsDeleted())) {
+            throw new IllegalArgumentException("Deleted routing lookup " + type + "/" + key);
+        }
+        try {
+            JsonNode metadata = mapper.readTree(entity.getMetadata());
+            if (metadata == null || !metadata.isObject()) { throw new IllegalArgumentException("Routing metadata must be an object"); }
+            return metadata;
+        } catch (java.io.IOException e) {
+            throw new IllegalArgumentException("Malformed routing metadata " + type + "/" + key, e);
+        }
+    }
+
+    private static String text(JsonNode node, String field) {
+        JsonNode value = node.get(field);
+        if (value == null || !value.isTextual() || value.textValue().isBlank() || value.textValue().length() > 255) {
+            throw new IllegalArgumentException("Invalid routing field " + field);
+        }
+        return value.textValue();
+    }
+}
