+/** Copyright (c) 2026, Flatirons Solutions. All Rights Reserved. */
+package com.flatirons.insight.service.runtime;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.flatirons.insight.service.runtime.listener.InsightJsonUtilListener;
+import com.flatirons.insight.service.runtime.listener.FlowConditionsBean;
+import org.flowable.engine.delegate.DelegateExecution;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import static org.mockito.Mockito.*;
+import static org.assertj.core.api.Assertions.*;
+import org.mockito.ArgumentCaptor;
+
+class CustomerReachedListenerTest {
+    @Test void extractsTextLinksFallbackAndEmptyValuesWithoutMutatingCallerJson() throws Exception {
+        var mapper = new ObjectMapper();
+        var table = mapper.readTree("[{\"reference\":{\"displayText\":\"Label\",\"hyperlink\":\"URL\"}},"
+                + "{\"reference\":{\"displayText\":\" \",\"hyperlink\":\"fallback\"}},"
+                + "{\"reference\":\"literal\"},{}]");
+        var original = table.deepCopy();
+        var execution = mock(DelegateExecution.class);
+        when(execution.getVariable("references")).thenReturn(table);
+        new InsightJsonUtilListener(mapper).extractDisplayTextToColumn(execution, "references", "reference", "displayReference");
+        var value = ArgumentCaptor.forClass(Object.class);
+        verify(execution).setVariable(eq("references"), value.capture());
+        var result = mapper.readTree(value.getValue().toString());
+        assertThat(result.findValuesAsText("displayReference")).containsExactly("Label", "fallback", "literal", "");
+        assertThat(table).isEqualTo(original);
+    }
+    @ParameterizedTest @ValueSource(strings = {"{}", "[1]", "invalid"})
+    void invalidTableRefusesBeforeVariableWrite(String value) {
+        var execution = mock(DelegateExecution.class);
+        when(execution.getVariable("references")).thenReturn(value);
+        assertThatThrownBy(() -> new InsightJsonUtilListener(new ObjectMapper())
+                .extractDisplayTextToColumn(execution, "references", "reference", "displayReference"))
+                .isInstanceOf(IllegalArgumentException.class);
+        verify(execution, never()).setVariable(anyString(), any());
+    }
+    @Test void absentTableKeepsLegacyAbsenceAndFalseIsPresentToGateway() {
+        var execution = mock(DelegateExecution.class);
+        var listener = new InsightJsonUtilListener(new ObjectMapper());
+        listener.extractDisplayTextToColumn(execution, "references", "reference", "displayReference");
+        verify(execution, never()).setVariable(anyString(), any());
+        var gateway = new FlowConditionsBean();
+        assertThat(gateway.exists(execution, "skipEmails")).isFalse();
+        when(execution.getVariable("skipEmails")).thenReturn(false);
+        assertThat(gateway.exists(execution, "skipEmails")).isTrue();
+    }
+}
