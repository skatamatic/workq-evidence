+package com.flatirons.insight.service.runtime.listener;
+
+import com.flatirons.insight.domain.UserEntity;
+import com.flatirons.insight.model.enums.status.UserAccountStatus;
+import com.flatirons.insight.model.records.security.InsightUserDetails;
+import com.flatirons.insight.repository.UserRepository;
+import com.flatirons.insight.security.InsightAppUser;
+import com.flatirons.insight.security.SecurityUtils;
+import org.flowable.engine.RepositoryService;
+import org.flowable.task.service.delegate.DelegateTask;
+import org.springframework.context.annotation.Lazy;
+import org.springframework.security.access.AccessDeniedException;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/** MDCR's reached ACM subset: username, first/last name and email, from persisted authenticated identity. */
+@Service("insightLdapListener")
+public class InsightLdapListener {
+    private final UserRepository users;
+    private final RepositoryService repository;
+
+    public InsightLdapListener(UserRepository users, @Lazy RepositoryService repository) {
+        this.users = users;
+        this.repository = repository;
+    }
+
+    @Transactional(transactionManager = "insightTransactionManager")
+    public void setLdapProcessVariables(DelegateTask task) {
+        String process = repository.getProcessDefinition(task.getProcessDefinitionId()).getKey();
+        if (!"MDCR".equalsIgnoreCase(process) || !"originate-mdcr".equals(task.getTaskDefinitionKey())) {
+            throw new IllegalArgumentException("Unsupported ACM mapping at " + task.getTaskDefinitionKey());
+        }
+        var authentication = SecurityUtils.getAuthentication();
+        if (authentication == null || !authentication.isAuthenticated()) {
+            throw new AccessDeniedException("Authenticated ACM identity required at " + task.getTaskDefinitionKey());
+        }
+        Long id;
+        String username;
+        if (authentication.getPrincipal() instanceof InsightUserDetails user) {
+            id = user.getUserId();
+            username = user.getUsername();
+        } else if (authentication.getPrincipal() instanceof InsightAppUser user) {
+            id = user.getId();
+            username = user.getUsername();
+        } else {
+            throw new AccessDeniedException("Authenticated ACM identity required");
+        }
+        if (id == null || username == null || username.isBlank()
+                || !username.equals(task.getVariable("initiator"))) {
+            throw new AccessDeniedException("ACM initiator mismatch at " + task.getTaskDefinitionKey());
+        }
+        UserEntity user = users.findById(id).orElseThrow(() -> new AccessDeniedException("ACM identity not found"));
+        if (!username.equals(user.getUserName()) || user.getAccountStatus() != UserAccountStatus.ACTIVE) {
+            throw new AccessDeniedException("ACM identity mismatch");
+        }
+        if (!"$INITIATOR".equals(task.getAssignee()) && !username.equals(task.getAssignee())) {
+            throw new AccessDeniedException("MDCR task must belong to its initiator");
+        }
+        // These mappings exist in legacy config-insight-acm-mapping.json. No invented department/title/phone.
+        task.setVariable("originator_id", user.getUserName());
+        task.setVariable("originator_first_name", user.getFirstName());
+        task.setVariable("originator_last_name", user.getLastName());
+        task.setVariable("originator_email", user.getEmail());
+        // The unchanged Activiti archive uses a literal marker; Flowable does not evaluate it as an expression.
+        if ("$INITIATOR".equals(task.getAssignee())) {
+            task.setAssignee(username);
+        }
+    }
+}
