+package com.flatirons.insight.service.runtime.listener;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.node.ObjectNode;
+import org.flowable.engine.delegate.DelegateExecution;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/** Source-backed display-text extraction on the reached Feedback start sequence flow. */
+@Service("insightJsonUtilListener")
+public class InsightJsonUtilListener {
+    private final ObjectMapper mapper;
+    public InsightJsonUtilListener(ObjectMapper mapper) { this.mapper = mapper; }
+
+    @Transactional(transactionManager = "insightTransactionManager")
+    public void extractDisplayTextToColumn(DelegateExecution execution, String source, String field, String column) {
+        Object raw = execution.getVariable(source);
+        if (raw == null) { return; } // Legacy absent-table behavior.
+        try {
+            JsonNode table = raw instanceof String text ? mapper.readTree(text) : mapper.valueToTree(raw);
+            if (table == null || !table.isArray()) {
+                throw new IllegalArgumentException("Expected array table " + source);
+            }
+            table = table.deepCopy();
+            for (JsonNode row : table) {
+                if (!(row instanceof ObjectNode object)) {
+                    throw new IllegalArgumentException("Expected object row in " + source);
+                }
+                JsonNode link = row.get(field);
+                String display = "";
+                if (link != null && link.isTextual()) {
+                    display = link.textValue();
+                } else if (link != null && link.isObject()) {
+                    display = link.path("displayText").asText("");
+                    if (display.isBlank()) { display = link.path("hyperlink").asText(""); }
+                }
+                object.put(column, display);
+            }
+            execution.setVariable(source, mapper.writeValueAsString(table));
+        } catch (java.io.IOException e) {
+            throw new IllegalArgumentException("Invalid table " + source + " at " + execution.getCurrentActivityId(), e);
+        }
+    }
+}
