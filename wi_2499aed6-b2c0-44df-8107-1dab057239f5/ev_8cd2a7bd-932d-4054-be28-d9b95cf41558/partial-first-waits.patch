+    void unavailableIdentityOrRoutingRollsBackArchiveStart(String fault) throws Exception {
+        try (var context = open()) {
+            ProcessEngine engine = context.getBean(ProcessEngine.class);
+            boolean mdcr = fault.equals("missing-identity");
+            String key = deploy(engine, mdcr ? "mdcr" : "safran-feedback");
+            UserEntity user = new UserEntity();
+            user.setId(999L);
+            user.setUserName("admin@app.insight.com");
+            authenticate(user, true);
+            if (!mdcr && !fault.equals("missing-rule")) {
+                routing(context, key);
+                var lookups = context.getBean(ReferenceDataLookupRepository.class);
+                if (fault.equals("inactive-group")) {
+                    var group = context.getBean(GroupRepository.class).findByName("Feedback Admin").orElseThrow();
+                    group.setStatus(GroupStatus.INACTIVE);
+                    context.getBean(GroupRepository.class).saveAndFlush(group);
+                } else if (fault.equals("missing-value")) {
+                    // Checked below via the actual start request.
+                } else if (fault.equals("missing-match")) {
+                    lookups.delete(lookups.findByLookupTypeAndKeyValue("feedback-sites", "Paris").orElseThrow());
+                } else if (fault.equals("missing-group")) {
+                    context.getBean(GroupRepository.class).deleteAll();
+                } else {
+                    var rule = lookups.findByLookupTypeAndKeyValue("workflow-task-routing", key + "/local-review-feedback").orElseThrow();
+                    if (fault.equals("deleted-rule")) { rule.setIsDeleted(true); }
+                    else if (fault.equals("wrong-task")) { rule.setMetadata(rule.getMetadata().replace("local-review-feedback", "wrong-task")); }
+                    else if (fault.equals("malformed-rule")) { rule.setMetadata("[]"); }
+                    else { rule.setMetadata(rule.getMetadata().replace(key, "wrong-process")); }
+                    lookups.saveAndFlush(rule);
+                }
+            }
+            var service = new ProcessInstanceServiceImpl(engine.getRuntimeService(), engine.getHistoryService(),
+                    mock(UserCache.class), mock(UserService.class), null, null, null, null, engine.getRepositoryService());
+            var request = new ProcessInstanceStartRequest();
+            request.setProcessDefinitionKey(key);
+            request.setVariables(fault.equals("missing-value") ? Map.of() : Map.of("submitting_site", "Paris"));
+            String expected = switch (fault) {
+                case "missing-identity" -> "ACM identity not found";
+                case "missing-rule" -> "Missing routing lookup workflow-task-routing";
+                case "wrong-process", "wrong-task" -> "Routing rule process/task mismatch";
+                case "missing-match" -> "Missing routing lookup feedback-sites/Paris";
+                case "missing-group" -> "Unresolved routing group";
+                case "deleted-rule" -> "Deleted routing lookup";
+                case "missing-value" -> "Missing routing lookup value";
+                case "inactive-group" -> "Inactive routing group";
+                case "malformed-rule" -> "Routing metadata must be an object";
+                default -> throw new IllegalArgumentException(fault);
+            };
+            assertThatThrownBy(() -> service.startProcessInstance(request)).isInstanceOf(RuntimeException.class)
+                    .hasStackTraceContaining(expected);
+            assertThat(engine.getRuntimeService().createProcessInstanceQuery().count()).isZero();
+            assertThat(engine.getTaskService().createTaskQuery().count()).isZero();
+            assertThat(engine.getHistoryService().createHistoricProcessInstanceQuery().count()).isZero();
+            assertThat(context.getBean(com.flatirons.insight.repository.InsightSequenceRepository.class).count()).isZero();
+            assertThat(context.getBean(com.flatirons.insight.repository.InsightProcessIdRepository.class).count()).isZero();
+        }
+    }
+
+    static AnnotationConfigApplicationContext open() {
+        var context = new AnnotationConfigApplicationContext();
+        String schema = "first_wait_" + java.util.UUID.randomUUID().toString().replace("-", "");
+        try (var connection = java.sql.DriverManager.getConnection(POSTGRES.getJdbcUrl(), POSTGRES.getUsername(), POSTGRES.getPassword());
+                var statement = connection.createStatement()) {
+            statement.execute("create schema " + schema);
+        } catch (java.sql.SQLException e) { throw new IllegalStateException(e); }
+        String url = POSTGRES.getJdbcUrl() + (POSTGRES.getJdbcUrl().contains("?") ? "&" : "?") + "currentSchema=" + schema;
+        context.getEnvironment().getPropertySources().addFirst(new MapPropertySource("firstWait",
+                Map.of("identifier.test.url", url, "identifier.test.username", POSTGRES.getUsername(),
+                        "identifier.test.password", POSTGRES.getPassword(), "identifier.test.schema", schema)));
+        context.register(CustomerFirstWaitTestConfiguration.class);
+        context.refresh();
+        return context;
+    }
+    private void authenticate(UserEntity user, boolean jwt) {
+        Object principal = jwt ? new InsightUserDetails(user.getUserName(), user.getId(), List.of(), List.of())
+                : new InsightAppUser(user, user.getUserName(), List.of());
+        SecurityContextHolder.getContext().setAuthentication(new UsernamePasswordAuthenticationToken(principal, null, List.of()));
+    }
+    static void routing(AnnotationConfigApplicationContext context, String key) {
+        GroupEntity group = new GroupEntity();
+        group.setName("Feedback Admin");
+        group.setGroupType(GroupType.GROUP);
+        group.setStatus(GroupStatus.ACTIVE);
+        context.getBean(GroupRepository.class).saveAndFlush(group);
+        save(context, "workflow-task-routing", key + "/local-review-feedback", "{\"processKey\":\"" + key
+                + "\",\"taskKey\":\"local-review-feedback\",\"lookupVariable\":\"submitting_site\","
+                + "\"lookupType\":\"feedback-sites\",\"taskName\":\"Paris: Local Support Feedback\"}");
+        save(context, "feedback-sites", "Paris", "{\"candidateGroup\":\"Feedback Admin\"}");
+    }
+    static void save(AnnotationConfigApplicationContext context, String type, String key, String metadata) {
+        var lookup = new ReferenceDataLookupEntity();
+        lookup.setLookupType(type);
+        lookup.setKeyValue(key);
+        lookup.setMetadata(metadata);
+        context.getBean(ReferenceDataLookupRepository.class).saveAndFlush(lookup);
+    }
+    static String deploy(ProcessEngine engine, String fixture) throws Exception {
+        try (InputStream input = CustomerFirstWaitScenarioTest.class.getClassLoader().getResourceAsStream("scenarios/customers/" + fixture + "/app.zip");
+                ZipInputStream zip = new ZipInputStream(input)) {
+            java.util.zip.ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                if (entry.getName().endsWith(".bpmn20.xml")) {
+                    var deployment = engine.getRepositoryService().createDeployment().addBytes(fixture + ".bpmn20.xml", zip.readAllBytes()).deploy();
+                    return engine.getRepositoryService().createProcessDefinitionQuery().deploymentId(deployment.getId()).singleResult().getKey();
+                }
+            }
+        }
+        throw new IllegalArgumentException("No archive BPMN");
+    }
+}
