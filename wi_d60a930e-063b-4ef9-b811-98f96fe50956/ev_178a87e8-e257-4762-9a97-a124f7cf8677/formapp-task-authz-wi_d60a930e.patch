+    private Snapshot snapshot(ProcessInstance instance) {
+        String processId = instance.getId();
+        Map<String, TaskState> tasks = new TreeMap<>();
+        for (Task task : processEngine.getTaskService().createTaskQuery().processInstanceId(processId).list()) {
+            tasks.put(task.getId(), new TaskState(task.getName(), task.getAssignee(), task.getOwner(),
+                    task.isSuspended(), task.getDelegationState(), task.getState(), task.getClaimedBy(), task.getClaimTime(),
+                    processEngine.getTaskService().getVariablesLocal(task.getId())));
+        }
+        Map<String, List<Object>> history = new TreeMap<>();
+        processEngine.getHistoryService().createHistoricTaskInstanceQuery().processInstanceId(processId).list()
+                .forEach(task -> history.put("task:" + task.getId(), java.util.Arrays.asList(
+                        task.getAssignee(), task.getOwner(), task.getEndTime(), task.getClaimTime(), task.getDeleteReason(), task.getState(), task.getClaimedBy())));
+        processEngine.getHistoryService().createHistoricActivityInstanceQuery().processInstanceId(processId).list()
+                .forEach(activity -> history.put("activity:" + activity.getId(), java.util.Arrays.asList(
+                        activity.getActivityId(), activity.getAssignee(), activity.getEndTime())));
+        processEngine.getHistoryService().createHistoricVariableInstanceQuery().processInstanceId(processId).list()
+                .forEach(variable -> history.put("variable:" + variable.getId(), java.util.Arrays.asList(
+                        variable.getTaskId(), variable.getVariableName(), variable.getValue())));
+        Map<String, List<String>> links = new TreeMap<>();
+        tasks.keySet().forEach(id -> links.put(id, processEngine.getHistoryService().getHistoricIdentityLinksForTask(id)
+                .stream().map(link -> link.getType() + ":" + link.getUserId() + ":" + link.getGroupId()).sorted().toList()));
+        return new Snapshot(tasks, activeTaskNames(instance), processEngine.getRuntimeService().getVariables(processId),
+                history, links);
+    }
+
+    private record TaskState(String name, String assignee, String owner, boolean suspended,
+                             Object delegation, String state, String claimedBy, Date claimTime, Map<String, Object> localVariables) { }
+    private record Snapshot(Map<String, TaskState> tasks, List<String> activeNames, Map<String, Object> variables,
+                            Map<String, List<Object>> history, Map<String, List<String>> identityLinks) { }
