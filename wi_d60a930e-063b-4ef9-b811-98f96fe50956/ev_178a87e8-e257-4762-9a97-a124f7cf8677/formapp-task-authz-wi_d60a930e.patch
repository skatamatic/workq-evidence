+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void reassignmentBetweenPermissionReadAndMutationRejectsStaleActor(boolean claim) throws Exception {
+        ProcessInstance instance = startFormApp(true);
+        String taskId = reliability(instance).getId();
+        TaskService engineTasks = processEngine.getTaskService();
+        TaskService interceptedTasks = spy(engineTasks);
+        try (var executor = Executors.newSingleThreadExecutor()) {
+            org.mockito.stubbing.Answer<Object> concurrentReassignment = invocation -> {
+                executor.submit(() -> engineTasks.setAssignee(taskId, INTRUDER)).get(10, TimeUnit.SECONDS);
+                return invocation.callRealMethod();
+            };
+            if (claim) {
+                doAnswer(concurrentReassignment).when(interceptedTasks).claim(anyString(), anyString());
+            } else {
+                doAnswer(concurrentReassignment).when(interceptedTasks).complete(anyString());
+            }
+            TaskActionServiceImpl guarded = new TaskActionServiceImpl(interceptedTasks,
+                    processEngine.getHistoryService(), processEngine.getRuntimeService(), mock(UserCache.class),
+                    mock(TaskRepository.class), processEngine.getManagementService(), userService);
+            if (claim) {
+                assertThatThrownBy(() -> guarded.claimTask(taskId))
+                        .hasRootCauseInstanceOf(FlowableOptimisticLockingException.class);
+            } else {
+                assertThatThrownBy(() -> guarded.completeTask(taskId))
+                        .isInstanceOf(FlowableOptimisticLockingException.class);
+            }
+        }
+        Task current = engineTasks.createTaskQuery().taskId(taskId).singleResult();
+        assertThat(current.getAssignee()).isEqualTo(INTRUDER);
+        assertThat(current.getClaimTime()).isNull();
+        assertThat(engineTasks.getVariablesLocal(taskId)).isEmpty();
+        assertThat(activeTaskNames(instance)).hasSize(10);
+        assertThat(processEngine.getHistoryService().createHistoricTaskInstanceQuery().taskId(taskId)
+                .singleResult().getEndTime()).isNull();
+        assertThat(processEngine.getRuntimeService().getVariable(instance.getId(), "businessValue"))
+                .isEqualTo("unchanged");
+    }
