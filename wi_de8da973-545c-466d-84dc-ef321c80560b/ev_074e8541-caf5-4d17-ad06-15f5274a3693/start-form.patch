@@ -0,0 +1,61 @@
+/** Copyright (c) 2026, Flatirons Solutions. All Rights Reserved. */
+package com.flatirons.insight.service.runtime;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.flatirons.insight.service.editor.ArchiveFormResources;
+import com.flatirons.insight.service.exception.BadRequestException;
+import java.io.IOException;
+import java.io.InputStream;
+import org.flowable.bpmn.model.StartEvent;
+import org.flowable.engine.RepositoryService;
+import org.flowable.engine.repository.ProcessDefinition;
+
+/** Resolves aliases and immutable form bytes within the selected definition's deployment. */
+final class ArchiveFormResolver {
+    private final RepositoryService repository;
+    private final ObjectMapper mapper;
+
+    ArchiveFormResolver(RepositoryService repository, ObjectMapper mapper) {
+        this.repository = repository;
+        this.mapper = mapper;
+    }
+
+    ResolvedForm startForm(ProcessDefinition definition) {
+        if (!repository.getDeploymentResourceNames(definition.getDeploymentId())
+                .contains(ArchiveFormResources.MAPPINGS_RESOURCE)) {
+            return null;
+        }
+        var process = repository.getBpmnModel(definition.getId()).getProcessById(definition.getKey());
+        var starts = process.findFlowElementsOfType(StartEvent.class, false).stream()
+                .filter(start -> start.getEventDefinitions().isEmpty()).toList();
+        if (starts.size() != 1) {
+            throw new BadRequestException("Archive requires exactly one ordinary start event");
+        }
+        String reference = starts.getFirst().getFormKey();
+        return reference == null || reference.isBlank() ? null : resolve(definition, reference);
+    }
+
+    ResolvedForm resolve(ProcessDefinition definition, String reference) {
+        String deploymentId = definition.getDeploymentId();
+        if (reference == null || !repository.getDeploymentResourceNames(deploymentId)
+                .contains(ArchiveFormResources.MAPPINGS_RESOURCE)) {
+            throw new BadRequestException("Process has no supported archive form mapping");
+        }
+        try (InputStream mapping = repository.getResourceAsStream(deploymentId, ArchiveFormResources.MAPPINGS_RESOURCE)) {
+            String key = mapper.readTree(mapping).path(reference).asText();
+            if (key.isBlank()) {
+                throw new BadRequestException("Unresolved form reference: " + reference);
+            }
+            if (!repository.getDeploymentResourceNames(deploymentId).contains(ArchiveFormResources.formResource(key))) {
+                throw new BadRequestException("Deployed form resource is missing: " + key);
+            }
+            try (InputStream resource = repository.getResourceAsStream(deploymentId, ArchiveFormResources.formResource(key))) {
+                return new ResolvedForm(key, new ArchiveFormDefinition(mapper.readTree(resource), mapper));
+            }
+        } catch (IOException ex) {
+            throw new BadRequestException("Cannot read deployed form resource", ex);
+        }
+    }
+
+    record ResolvedForm(String key, ArchiveFormDefinition definition) { }
+}
