+    @Test
+    void explicitDefinitionUsesItsOwnFormEvenAfterAnotherVersionWithTheSameAlias() throws Exception {
+        var feedback = feedback();
+        var analysis = carrier("safran-analysis", "AnalystStart-13", "318", "13", feedback.getKey());
+        assertThat(analysis.getVersion()).isEqualTo(feedback.getVersion() + 1);
+        assertThat(forms().getFormData(null, feedback.getId()).getFormKey()).endsWith("/PPStart");
+        assertThat(forms().getFormData(null, analysis.getId()).getFormKey()).endsWith("/AnalystStart");
+        var old = starts().startProcessInstance(request(feedback, values("safran-feedback")));
+        assertThat(engine.getRuntimeService().createProcessInstanceQuery().processInstanceId(old.getId()).singleResult()
+                .getProcessDefinitionId()).isEqualTo(feedback.getId());
+        var latest = request(analysis, values("safran-analysis"));
+        latest.setProcessDefinitionId(null); latest.setProcessDefinitionKey(feedback.getKey());
+        var started = starts().startProcessInstance(latest);
+        assertThat(engine.getRuntimeService().createProcessInstanceQuery().processInstanceId(started.getId()).singleResult()
+                .getProcessDefinitionId()).isEqualTo(analysis.getId());
+    }
