+    @ParameterizedTest
+    @CsvSource({"required", "placeholder", "unknown-option", "wrong-type", "unknown-field", "upload", "raw-variable", "wrong-form", "missing-values"})
+    void invalidFeedbackFieldsRefuseBeforeAnyMutation(String failure) throws Exception {
+        var definition = feedback();
+        var values = new LinkedHashMap<>(values("safran-feedback"));
+        var request = request(definition, values);
+        switch (failure) {
+            case "required" -> values.remove("submitting_site");
+            case "placeholder" -> values.put("submitting_site", "empty");
+            case "unknown-option" -> values.put("submitting_site", "invented");
+            case "wrong-type" -> values.put("submitter_first_name", 42L);
+            case "unknown-field" -> values.put("undeclared", "value");
+            case "upload" -> values.put("feedback_document", List.of(Map.of("id", 1L)));
+            case "raw-variable" -> request.setVariables(Map.of("submitting_site", "SAESB"));
+            case "wrong-form" -> request.setFormId("319");
+            case "missing-values" -> values.clear();
+            default -> throw new IllegalStateException(failure);
+        }
+        request.setValues(values);
+        assertThatThrownBy(() -> starts().startProcessInstance(request)).isInstanceOf(BadRequestException.class);
+        assertNothingCreated();
+    }
