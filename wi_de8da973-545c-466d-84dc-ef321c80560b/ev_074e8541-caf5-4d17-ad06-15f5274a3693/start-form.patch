+    /** Bounded legacy start mapping: field ids and schema-backed dropdown id/_LABEL pairs. */
+    Map<String, Object> startVariables(Map<String, Object> submitted) {
+        Map<String, Object> validated = validatedValues(submitted);
+        Map<String, Object> result = new LinkedHashMap<>();
+        validated.forEach((id, value) -> {
+            JsonNode field = fields.get(id);
+            if (!field.path("params").path("field").isMissingNode()) {
+                throw new BadRequestException("Start field binding is not supported: " + id);
+            }
+            if ("initiator".equals(id) || fields.containsKey(id + "_LABEL")) {
+                throw new BadRequestException("Reserved or colliding start field: " + id);
+            }
+            if ("dropdown".equals(field.path("type").asText())) {
+                Object selected = value instanceof Map<?, ?> option ? option.get("id") : value;
+                result.put(id, selected);
+                Object label = null;
+                if (!empty(value)) {
+                    for (JsonNode option : field.path("options")) {
+                        if (option.path("id").asText().equals(selected)) {
+                            label = option.path("name").asText();
+                        }
+                    }
+                }
+                result.put(id + "_LABEL", label);
+            } else {
+                result.put(id, value);
+            }
+        });
+        return result;
+    }
+
     private boolean writable(JsonNode field) {
