+    @ParameterizedTest
+    @CsvSource({"safran-feedback,false", "safran-feedback,true", "safran-analysis,false", "safran-analysis,true"})
+    void exactArchivedFieldsStartOnlyTheIsolatedCarrier(String fixture, boolean jwt) throws Exception {
+        authenticate(jwt);
+        var definition = fixture.equals("safran-feedback") ? feedback()
+                : carrier(fixture, "AnalystStart-13", "297", "13", "isolatedAnalysisCarrier");
+        var data = forms().getFormData(null, definition.getId());
+        assertThat(data.getTaskId()).isNull();
+        assertThat(data.getProcessDefinitionId()).isEqualTo(definition.getId());
+        assertThat(data.getFormKey()).endsWith(fixture.equals("safran-feedback") ? "/PPStart" : "/AnalystStart");
+        assertThat(data.getFields()).extracting(field -> field.getId()).containsAll(values(fixture).keySet());
+        var request = request(definition, values(fixture));
+        request.setFormId(fixture.equals("safran-feedback") ? "3" : "13");
+        var response = starts().startProcessInstance(request);
+        var runtime = engine.getRuntimeService();
+        var expected = new LinkedHashMap<>(values(fixture));
+        expected.put("initiator", user.getUserName());
+        if (fixture.equals("safran-feedback")) {
+            expected.put("submitting_site", "SAESB"); expected.put("submitting_site_LABEL", "SAESB");
+        }
+        assertThat(runtime.getVariables(response.getId())).isEqualTo(expected);
+        assertThat(engine.getTaskService().createTaskQuery().singleResult().getAssignee()).isEqualTo(user.getUserName());
+        assertThat(engine.getHistoryService().createHistoricProcessInstanceQuery().singleResult().getStartUserId())
+                .isEqualTo(user.getUserName());
+        expected.forEach((name, value) -> assertThat(engine.getHistoryService().createHistoricVariableInstanceQuery()
+                .processInstanceId(response.getId()).variableName(name).singleResult().getValue()).isEqualTo(value));
+        assertOutboundAndContentUnchanged();
+        System.out.printf("ISOLATED START FORM %s JWT=%s: exact bytes, declared typed values, identity, labels, persisted history; customer journey PENDING%n", fixture, jwt);
+    }
