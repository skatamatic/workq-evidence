+    private byte[] archivedForm(String fixture, String name) throws Exception {
+        try (var input = getClass().getResourceAsStream("/scenarios/customers/" + fixture + "/app.zip");
+                var zip = new ZipInputStream(input)) {
+            java.util.zip.ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                if (entry.getName().equals("form-models/" + name + ".json")) { return zip.readAllBytes(); }
+            }
+        }
+        throw new IllegalStateException("Missing archived form: " + name);
+    }
+
+    private ProcessDefinition carrier(String fixture, String source, String alias, String sourceAlias, String key) throws Exception {
+        byte[] bytes = archivedForm(fixture, source);
+        String hash = java.util.HexFormat.of().formatHex(java.security.MessageDigest.getInstance("SHA-256").digest(bytes));
+        assertThat(hash).isEqualTo(source.equals("PPStart-3")
+                ? "79842ee07ace272215263d8fbe627b8be556488e90cb07bc8879871b53cae2cf"
+                : "246bead0482ed82b3ac00cf4265985cbb4ad06a28bb5ca0fdc59f89f44fa4197");
+        String formKey = fixture + "/" + MAPPER.readTree(bytes).path("name").asText();
+        String bpmn = """
+                <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
+                  xmlns:flowable="http://flowable.org/bpmn" targetNamespace="isolated-start-form-carrier">
+                  <process id="%s" isExecutable="true">
+                    <startEvent id="start" flowable:formKey="%s" flowable:initiator="initiator"/>
+                    <sequenceFlow id="begin" sourceRef="start" targetRef="wait"/>
+                    <userTask id="wait" name="Isolated start-form receipt" flowable:assignee="${initiator}"/>
+                    <sequenceFlow id="finish" sourceRef="wait" targetRef="end"/><endEvent id="end"/>
+                  </process>
+                </definitions>
+                """.formatted(key, alias);
+        var repository = engine.getRepositoryService();
+        var deployment = repository.createDeployment().addString("isolated-carrier.bpmn20.xml", bpmn)
+                .addString(ArchiveFormResources.MAPPINGS_RESOURCE,
+                        MAPPER.writeValueAsString(Map.of(alias, formKey, sourceAlias, formKey, formKey, formKey)))
+                .addBytes(ArchiveFormResources.formResource(formKey), bytes).deploy();
+        try (var resource = repository.getResourceAsStream(deployment.getId(), ArchiveFormResources.formResource(formKey))) {
+            assertThat(resource.readAllBytes()).isEqualTo(bytes);
+        }
+        return repository.createProcessDefinitionQuery().deploymentId(deployment.getId()).singleResult();
+    }
+
+    private ProcessDefinition feedback() throws Exception {
+        return carrier("safran-feedback", "PPStart-3", "318", "3", "isolatedStartCarrier");
+    }
+
+    private Map<String, Object> values(String fixture) {
+        return fixture.equals("safran-feedback")
+                ? Map.of("submitting_site", Map.of("id", "SAESB", "name", "Spoofed label"),
+                        "submitting_date", "2026-10-08", "submitter_first_name", "Ada", "references", List.of())
+                : Map.of("manualName", "Manual", "revisionType", "normal", "publicationId", "PUB-42",
+                        "publication_url", "https://example.invalid/PUB-42", "revisionNumber", "9");
+    }
+
+    private ProcessInstanceStartRequest request(ProcessDefinition definition, Map<String, Object> values) throws Exception {
+        var request = new ProcessInstanceStartRequest();
+        request.setProcessDefinitionId(definition.getId());
+        request.setValues(values);
+        request.setVariables(Map.of("initiator", "spoofed@insight.test"));
+        // Exercise the real authoring/transport serialization boundary before the production reader.
+        return MAPPER.readValue(MAPPER.writeValueAsBytes(request), ProcessInstanceStartRequest.class);
+    }
