+    static String publish(CustomerWorkflowHttpRuntime.HttpRun run) throws Exception {
+        byte[] archive;
+        try (var input=InsightBrowserRuntime.class.getClassLoader().getResourceAsStream("scenarios/customers/form-app/app.zip")) {
+            if (input==null) { throw new IOException("Missing pinned FormApp archive"); }
+            archive=input.readAllBytes();
+        }
+        String hash=HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(archive));
+        if (!FIXTURE_HASH.equals(hash)) { throw new IllegalStateException("Pinned FormApp archive hash differs"); }
+        return JSON.readTree(run.request("POST","/api/internal/workflow-archives",run.system,archive,"application/zip",200))
+                .path("processDefinitions").get(0).path("id").asText();
+    }
+
+    static Map<String,Object> receipt(CustomerWorkflowHttpRuntime.HttpRun run,String commit) {
+        return Map.of("sourceCommit",commit,"runId",run.schema,"schema",run.schema,"baseUrl",run.base.toString(),
+                "fixtureSha256",FIXTURE_HASH,"authenticationProof","browser requests; credential login UI excluded");
+    }
+
+    static String sourceCommit() throws Exception {
+        var process=new ProcessBuilder("git","rev-parse","HEAD").redirectErrorStream(true).start();
+        if (!process.waitFor(5,TimeUnit.SECONDS)) {
+            process.destroyForcibly(); process.waitFor(); throw new IOException("Source commit lookup timed out");
+        }
+        String sha=new String(process.getInputStream().readAllBytes(),java.nio.charset.StandardCharsets.UTF_8).trim();
+        if (process.exitValue()!=0 || !sha.matches("[0-9a-f]{40}")) { throw new IOException("Cannot resolve source commit"); }
+        return sha;
+    }
+
+    static final class Session extends HttpServlet {
+        final String capability=UUID.randomUUID().toString()+UUID.randomUUID();
+        final int seconds;
+        final CountDownLatch stopped;
+        volatile CustomerWorkflowHttpRuntime.HttpRun run;
+        Session(int seconds,CountDownLatch stopped) { this.seconds=seconds; this.stopped=stopped; }
+        @Override protected void doGet(HttpServletRequest request,HttpServletResponse response) throws IOException {
+            response.setHeader("Cache-Control","no-store");
+            var current=run;
+            String origin=request.getHeader("Origin");
+            if (current==null || !"127.0.0.1".equals(request.getRemoteAddr())
+                    || !"127.0.0.1".equals(request.getServerName())
+                    || (origin!=null && !current.base.toString().equals(origin))
+                    || !capability.equals(request.getHeader("X-Insight-Test-Capability"))) {
+                response.sendError(403); return;
+            }
+            String actor=request.getParameter("actor");
+            if ("shutdown".equals(actor)) { response.setStatus(204); stopped.countDown(); return; }
+            String token=switch (actor==null ? "" : actor) {
+                case "owner" -> current.owner;
+                case "nonassignee" -> current.refused;
+                case "invalid" -> "invalid-token";
+                case "anonymous" -> "";
+                default -> null;
+            };
+            if (token==null) { response.sendError(400); return; }
+            response.setHeader("Set-Cookie","acmToken="+token+"; Path=/; HttpOnly; SameSite=Lax; Max-Age="+(token.isEmpty() ? 0 : seconds));
+            response.setStatus(204);
+        }
+    }
+}
