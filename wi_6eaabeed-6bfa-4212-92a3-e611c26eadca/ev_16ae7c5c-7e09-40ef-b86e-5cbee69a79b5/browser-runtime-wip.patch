+@Testcontainers
+class InsightBrowserRuntimeTest {
+    @Container static final PostgreSQLContainer<?> POSTGRES=new PostgreSQLContainer<>("postgres:16-alpine");
+
+    @Test void cookieIdentityRealQueriesRefusalsAndFreshSchemaCleanup() throws Exception {
+        String previous=null;
+        for (int repeat=0;repeat<2;repeat++) {
+            var session=new InsightBrowserRuntime.Session(120,new CountDownLatch(1));
+            String schema; Path directory; URI base;
+            try (var run=new CustomerWorkflowHttpRuntime.HttpRun(POSTGRES,"form-app",120,session)) {
+                session.run=run; schema=run.schema; directory=run.directory; base=run.base;
+                assertThat(schema).isNotEqualTo(previous); previous=schema;
+                assertThat(run.engine.getRuntimeService().createProcessInstanceQuery().count()).isZero();
+                String definition=InsightBrowserRuntime.publish(run);
+                var receipt=InsightBrowserRuntime.receipt(run,InsightBrowserRuntime.sourceCommit());
+                assertThat(receipt.get("fixtureSha256")).isEqualTo(InsightBrowserRuntime.FIXTURE_HASH);
+                assertThat(InsightBrowserRuntime.JSON.writeValueAsString(receipt)).doesNotContain(run.owner,session.capability,"password");
+                var cookies=new CookieManager(null,CookiePolicy.ACCEPT_ALL);
+                try (var browser=HttpClient.newBuilder().cookieHandler(cookies).build()) {
+                    assertThat(send(browser,base,"GET","/api/internal/user/info",null,null).statusCode()).isEqualTo(401);
+                    assertThat(bootstrap(browser,run,session,"owner",null).statusCode()).isEqualTo(403);
+                    assertThat(bootstrap(browser,run,session,"owner",session.capability).statusCode()).isEqualTo(204);
+                    assertThat(cookies.getCookieStore().getCookies().stream().filter(cookie -> cookie.getName().equals("acmToken")).findFirst().orElseThrow().isHttpOnly()).isTrue();
+                    assertThat(send(browser,base,"GET","/api/internal/user/info",null,null).body()).contains(CustomerWorkflowHttpRuntime.OWNER);
+                    assertThat(send(browser,base,"GET","/api/internal/app/definitions",null,null).body()).contains("FormApp");
+                    assertThat(send(browser,base,"GET","/api/internal/process-definitions?latest=true",null,null).body()).contains(definition);
+                    String payload=InsightBrowserRuntime.JSON.writeValueAsString(Map.of("processDefinitionId",definition));
+                    var start=send(browser,base,"POST","/api/internal/process-instance",payload,null);
+                    assertThat(start.statusCode()).isEqualTo(200);
+                    String process=InsightBrowserRuntime.JSON.readTree(start.body()).path("id").asText();
+                    String task=run.engine.getTaskService().createTaskQuery().processInstanceId(process).list().getFirst().getId();
+                    var tasks=send(browser,base,"POST","/api/internal/query/tasks","{\"state\":\"active\",\"assignment\":\"assignee\"}",null);
+                    assertThat(tasks.statusCode()).as(tasks.body()).isEqualTo(200); assertThat(tasks.body()).contains(task);
+                    var details=send(browser,base,"GET","/api/internal/task/"+task,null,null);
+                    assertThat(details.statusCode()).isEqualTo(200); assertThat(details.body()).contains(task);
+                    var processes=send(browser,base,"POST","/api/internal/query/process-instances","{\"state\":\"running\"}",null);
+                    assertThat(processes.statusCode()).isEqualTo(200); assertThat(processes.body()).contains(process);
+                    for (String actor:List.of("nonassignee","anonymous","invalid")) {
+                        assertThat(bootstrap(browser,run,session,actor,session.capability).statusCode()).isEqualTo(204);
+                        var info=send(browser,base,"GET","/api/internal/user/info",null,null);
+                        assertThat(info.statusCode()).isEqualTo(actor.equals("nonassignee") ? 200 : 401);
+                        if (actor.equals("nonassignee")) { assertThat(info.body()).contains(CustomerWorkflowHttpRuntime.REFUSED); }
+                        var before=run.snapshot();
+                        var refusal=send(browser,base,"PUT","/api/internal/task/"+task+"/action/complete",null,null);
+                        assertThat(refusal.statusCode()).isEqualTo(actor.equals("invalid") ? 401 : 403);
+                        assertThat(run.snapshot()).isEqualTo(before);
+                    }
+                }
+            }
+            assertThat(directory).doesNotExist();
+            try (var connection=POSTGRES.createConnection("");var statement=connection.prepareStatement("select count(*) from information_schema.schemata where schema_name=?")) {
+                statement.setString(1,schema);
+                try (var result=statement.executeQuery()) { result.next(); assertThat(result.getInt(1)).isZero(); }
+            }
+            try (var client=HttpClient.newHttpClient()) {
+                assertThatThrownBy(() -> send(client,base,"GET","/api/internal/user/info",null,null)).isInstanceOf(java.io.IOException.class);
+            }
+        }
+    }
+
+    static HttpResponse<String> bootstrap(HttpClient browser,CustomerWorkflowHttpRuntime.HttpRun run,InsightBrowserRuntime.Session session,String actor,String capability) throws Exception {
+        return send(browser,run.base,"GET","/api/internal/__test/session?actor="+actor,null,capability);
+    }
+    static HttpResponse<String> send(HttpClient client,URI base,String method,String path,String body,String capability) throws Exception {
+        var request=HttpRequest.newBuilder(base.resolve(path)).timeout(java.time.Duration.ofSeconds(30)).header("Content-Type","application/json");
+        if (capability!=null) { request.header("X-Insight-Test-Capability",capability); }
+        return client.send(request.method(method,body==null ? HttpRequest.BodyPublishers.noBody() : HttpRequest.BodyPublishers.ofString(body)).build(),HttpResponse.BodyHandlers.ofString());
+    }
