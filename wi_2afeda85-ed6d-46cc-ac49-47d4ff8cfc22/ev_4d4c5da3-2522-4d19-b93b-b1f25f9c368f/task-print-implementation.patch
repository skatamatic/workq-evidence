@@ -0,0 +1,169 @@
+import { provideHttpClient } from '@angular/common/http';
+import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
+import { fakeAsync, flush, TestBed } from '@angular/core/testing';
+import { provideRouter, Router } from '@angular/router';
+import { RouterTestingHarness } from '@angular/router/testing';
+import { TaskPrintComponent } from './task-print.component';
+import type { ITaskPrintPreload } from './task-print-preload';
+import { isTaskPrintPath, taskPrintRoutes } from './task-print.routes';
+
+const snapshot = (): ITaskPrintPreload => ({
+  version: 1,
+  task: {
+    id: 'parent-1',
+    processInstanceId: 'process-1',
+    parentTaskId: null,
+    title: 'Synthetic inspection',
+    state: 'completed',
+    completedAt: '2026-10-08T12:00:00Z',
+  },
+  fields: [{ label: 'Result', kind: 'text', value: 'Passed' }],
+  attachments: [{ name: 'Record.pdf', mediaType: 'application/pdf' }],
+});
+
+describe('Preload-only task print route', () => {
+  beforeEach(() => {
+    window.__PRINT_READY__ = true;
+    delete window.__PRINT_PRELOAD;
+    TestBed.configureTestingModule({
+      providers: [provideRouter(taskPrintRoutes), provideHttpClient(), provideHttpClientTesting()],
+    });
+  });
+
+  afterEach(() => {
+    TestBed.inject(HttpTestingController).verify();
+    delete window.__PRINT_PRELOAD;
+    window.__PRINT_READY__ = false;
+  });
+
+  it('renders the complete valid snapshot without services or editable controls', async () => {
+    window.__PRINT_PRELOAD = snapshot();
+    const harness = await RouterTestingHarness.create();
+    await harness.navigateByUrl('/print/task/parent-1', TaskPrintComponent);
+    const element = harness.routeNativeElement!;
+    expect(element.textContent).toContain('Synthetic inspection');
+    expect(element.textContent).toContain('process-1');
+    expect(element.textContent).toContain('Passed');
+    expect(element.textContent).toContain('Record.pdf');
+    expect(element.querySelector('input, textarea, select, button, form, a, [contenteditable]')).toBeNull();
+    TestBed.inject(HttpTestingController).expectNone(() => true);
+  });
+
+  for (const [name, preload] of [
+    ['absent', undefined],
+    ['wrong task', { ...snapshot(), task: { ...snapshot().task, id: 'other' } }],
+    ['wrong version', { ...snapshot(), version: 2 }],
+    ['incomplete', { version: 1 }],
+    ['active task', { ...snapshot(), task: { ...snapshot().task, state: 'active' } }],
+    [
+      'external image',
+      {
+        ...snapshot(),
+        attachments: [{ name: 'secret', mediaType: 'image/png', imageDataUrl: 'https://example.com/private' }],
+      },
+    ],
+    ['caller identity', { ...snapshot(), userId: 'other-user' }],
+    ['unknown form family', { ...snapshot(), fields: [{ label: 'secret', kind: 'archiveScript', value: 'secret' }] }],
+  ] as const) {
+    it(`refuses ${name} preload without customer data or requests`, async () => {
+      window.__PRINT_PRELOAD = preload;
+      const harness = await RouterTestingHarness.create();
+      await harness.navigateByUrl('/print/task/parent-1', TaskPrintComponent);
+      expect(harness.routeNativeElement!.textContent).toContain('Task print unavailable');
+      expect(harness.routeNativeElement!.textContent).not.toContain('Synthetic inspection');
+      expect(harness.routeNativeElement!.querySelector('.task-print')).toBeNull();
+      expect(window.__PRINT_READY__).toBeFalse();
+      TestBed.inject(HttpTestingController).expectNone(() => true);
+    });
+  }
+
+  it('keeps safe formatting but removes executable markup, URLs and controls', async () => {
+    const data = snapshot();
+    data.fields = [
+      {
+        label: 'Notes',
+        kind: 'richText',
+        value:
+          '<p onclick="alert(1)">Safe <strong>bold</strong></p><script>alert(1)</script>' +
+          '<img src="https://example.com/tracker"><iframe src="https://example.com"></iframe>' +
+          '<a href="javascript:alert(1)">link</a><input value="secret"><style>body{display:none}</style>',
+      },
+    ];
+    window.__PRINT_PRELOAD = data;
+    const harness = await RouterTestingHarness.create();
+    await harness.navigateByUrl('/print/task/parent-1', TaskPrintComponent);
+    const element = harness.routeNativeElement!;
+    expect(element.querySelector('strong')!.textContent).toBe('bold');
+    expect(element.querySelector('script, img, iframe, input, a, style, [onclick]')).toBeNull();
+  });
+
+  it('isolates print URLs including invalid ones from normal application bootstrap', () => {
+    expect(isTaskPrintPath('/insightclient/print/task/parent-1')).toBeTrue();
+    expect(isTaskPrintPath('/print/task/parent-1')).toBeTrue();
+    expect(isTaskPrintPath('/insightclient/print/bad')).toBeTrue();
+    expect(isTaskPrintPath('/insightclient/task/parent-1')).toBeFalse();
+    expect(taskPrintRoutes.every((route) => !route.canActivate && !route.resolve)).toBeTrue();
+  });
+
+  it('waits for images, fonts and two frames before signaling readiness', fakeAsync(() => {
+    let resolveImage!: () => void;
+    let resolveFont!: (value: FontFaceSet) => void;
+    spyOnProperty(document.fonts, 'ready', 'get').and.returnValue(new Promise((resolve) => (resolveFont = resolve)));
+    spyOn(HTMLImageElement.prototype, 'decode').and.returnValue(new Promise((resolve) => (resolveImage = resolve)));
+    const frames: FrameRequestCallback[] = [];
+    spyOn(window, 'requestAnimationFrame').and.callFake((callback) => {
+      frames.push(callback);
+      return frames.length;
+    });
+    const data = snapshot();
+    data.attachments = [{ name: 'image', mediaType: 'image/png', imageDataUrl: 'data:image/png;base64,AAAA' }];
+    window.__PRINT_PRELOAD = data;
+    let component!: TaskPrintComponent;
+    void RouterTestingHarness.create()
+      .then((harness) => harness.navigateByUrl('/print/task/parent-1', TaskPrintComponent))
+      .then((value) => (component = value));
+    flush();
+    expect(window.__PRINT_READY__).toBeFalse();
+    resolveImage();
+    flush();
+    expect(window.__PRINT_READY__).toBeFalse();
+    resolveFont(document.fonts);
+    flush();
+    expect(frames.length).toBe(1);
+    frames.shift()!(0);
+    flush();
+    expect(window.__PRINT_READY__).toBeFalse();
+    frames.shift()!(0);
+    flush();
+    expect(window.__PRINT_READY__).toBeTrue();
+    component.ngOnDestroy();
+    expect(window.__PRINT_READY__).toBeFalse();
+  }));
+
+  it('does not let stale asset completion mark a mismatched replacement ready', fakeAsync(() => {
+    let resolveFont!: (value: FontFaceSet) => void;
+    spyOnProperty(document.fonts, 'ready', 'get').and.returnValue(new Promise((resolve) => (resolveFont = resolve)));
+    window.__PRINT_PRELOAD = snapshot();
+    void RouterTestingHarness.create().then((harness) =>
+      harness.navigateByUrl('/print/task/parent-1', TaskPrintComponent)
+    );
+    flush();
+    void TestBed.inject(Router).navigateByUrl('/print/task/child-1');
+    flush();
+    resolveFont(document.fonts);
+    flush();
+    expect(window.__PRINT_READY__).toBeFalse();
+  }));
+
+  it('keeps readiness false after an image decode failure', fakeAsync(() => {
+    spyOn(HTMLImageElement.prototype, 'decode').and.returnValue(Promise.reject(new Error('invalid image')));
+    const data = snapshot();
+    data.attachments = [{ name: 'image', mediaType: 'image/png', imageDataUrl: 'data:image/png;base64,AAAA' }];
+    window.__PRINT_PRELOAD = data;
+    void RouterTestingHarness.create().then((harness) =>
+      harness.navigateByUrl('/print/task/parent-1', TaskPrintComponent)
+    );
+    flush();
+    expect(window.__PRINT_READY__).toBeFalse();
+  }));
+});
