@@ -0,0 +1,61 @@
+@if (snapshot; as data) {
+  <main class="task-print">
+    <header>
+      <p
+        i18n
+        class="eyebrow"
+      >
+        Completed task record
+      </p>
+      <h1>{{ data.task.title }}</h1>
+      <dl class="identity">
+        <dt i18n>Task</dt>
+        <dd>{{ data.task.id }}</dd>
+        <dt i18n>Process</dt>
+        <dd>{{ data.task.processInstanceId }}</dd>
+        @if (data.task.parentTaskId) {
+          <dt i18n>Parent task</dt>
+          <dd>{{ data.task.parentTaskId }}</dd>
+        }
+        <dt i18n>Completed</dt>
+        <dd>{{ data.task.completedAt }}</dd>
+      </dl>
+    </header>
+    <section aria-label="Form values">
+      @for (field of data.fields; track $index) {
+        <article class="field">
+          <h2>{{ field.label }}</h2>
+          @if (field.kind === 'richText') {
+            <div [innerHTML]="field.value"></div>
+          } @else {
+            <p class="text-value">{{ field.value }}</p>
+          }
+        </article>
+      }
+    </section>
+    @if (data.attachments.length) {
+      <section aria-label="Visible attachments">
+        <h2 i18n>Attachments</h2>
+        @for (attachment of data.attachments; track $index) {
+          <figure>
+            @if (attachment.imageDataUrl) {
+              <img
+                [src]="attachment.imageDataUrl"
+                [alt]="attachment.name"
+              />
+            }
+            <figcaption>{{ attachment.name }} · {{ attachment.mediaType }}</figcaption>
+          </figure>
+        }
+      </section>
+    }
+  </main>
+} @else {
+  <main
+    class="refusal"
+    role="alert"
+  >
+    <h1 i18n>Task print unavailable</h1>
+    <p i18n>A valid completed-task snapshot was not provided. No task data has been loaded.</p>
+  </main>
+}
