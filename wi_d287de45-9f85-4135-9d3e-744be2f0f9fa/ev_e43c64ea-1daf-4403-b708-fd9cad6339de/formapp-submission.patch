+++ b/insight-rest/src/test/java/com/flatirons/insight/rest/internal/form/FormAppFormControllerTest.java
@@ -0,0 +1,111 @@
+/**
+ * Copyright (c) 2026, Flatirons Solutions. All Rights Reserved.
+ */
+package com.flatirons.insight.rest.internal.form;
+
+import com.flatirons.insight.model.request.FormSubmitRequest;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.mock;
+
+class FormAppFormControllerTest {
+
+    @Test
+    void invalidAndForeignActorSubmissionsReturnHttpErrorsWithoutChangingWorkflow() throws Exception {
+        var config = (org.flowable.engine.impl.cfg.ProcessEngineConfigurationImpl)
+                org.flowable.engine.ProcessEngineConfiguration.createStandaloneInMemProcessEngineConfiguration();
+        config.setPreBpmnParseHandlers(java.util.List.of(
+                new com.flatirons.insight.conf.LegacyInitiatorAssignmentParseHandler()));
+        var engine = config.setJdbcUrl("jdbc:h2:mem:form_http_" + java.util.UUID.randomUUID())
+                .setDatabaseSchemaUpdate(org.flowable.engine.ProcessEngineConfiguration.DB_SCHEMA_UPDATE_TRUE)
+                .setAsyncExecutorActivate(false).buildProcessEngine();
+        var previousAuthentication = org.flowable.common.engine.impl.identity.Authentication.getAuthenticationContext();
+        org.flowable.common.engine.impl.identity.Authentication.setAuthenticationContext(
+                new com.flatirons.insight.conf.security.SpringSecurityAuthenticationContext());
+        try {
+            var mapper = new com.fasterxml.jackson.databind.ObjectMapper();
+            var publisher = new com.flatirons.insight.service.editor.FormAppArchiveService(engine.getRepositoryService(), mapper);
+            try (var archive = java.nio.file.Files.newInputStream(java.nio.file.Path.of(
+                    "../insight-service/src/test/resources/scenarios/customers/form-app/app.zip"))) {
+                publisher.deploy(archive);
+            }
+            authenticateFormActor("admin@app.insight.com", 42L);
+            var startService = new com.flatirons.insight.service.runtime.ProcessInstanceServiceImpl(
+                    engine.getRuntimeService(), engine.getHistoryService(),
+                    mock(com.flatirons.insight.service.runtime.UserCache.class),
+                    mock(com.flatirons.insight.service.runtime.UserService.class),
+                    null, null, null, null, engine.getRepositoryService());
+            var start = new com.flatirons.insight.model.request.ProcessInstanceStartRequest();
+            start.setProcessDefinitionKey("FormProcess");
+            start.setVariables(java.util.Map.of("businessValue", "preserved"));
+            String processId = startService.startProcessInstance(start).getId();
+            var task = engine.getTaskService().createTaskQuery().processInstanceId(processId)
+                    .taskName("Reliability").singleResult();
+            var taskSnapshot = formTaskSnapshot(engine, processId);
+            var variableSnapshot = engine.getRuntimeService().getVariables(processId);
+            var realService = new com.flatirons.insight.service.runtime.FormServiceImpl(
+                    engine.getTaskService(), engine.getRepositoryService(), engine.getRuntimeService(),
+                    engine.getHistoryService(), mapper);
+            var mvc = org.springframework.test.web.servlet.setup.MockMvcBuilders
+                    .standaloneSetup(new FormController(realService))
+                    .setControllerAdvice(new com.flatirons.insight.rest.exception.RestExceptionHandlerAdvice()).build();
+            var valid = new java.util.LinkedHashMap<String, Object>();
+            valid.put("user_assignee_reliability", java.util.Map.of("id", 42));
+            valid.put("due_date_reliability", "2017-03-15T12:00:00.000Z");
+            valid.put("prior_to_implementation_faa", "Yes");
+            valid.put("escalation_20_percent", "No");
+            valid.put("action_reliability", "Completed");
+            var request = new FormSubmitRequest();
+            request.setTaskId(task.getId());
+            var missingRequired = new java.util.LinkedHashMap<>(valid);
+            missingRequired.remove("due_date_reliability");
+            request.setValues(missingRequired);
+            mvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post("/api/internal/form/data")
+                    .contentType(org.springframework.http.MediaType.APPLICATION_JSON)
+                    .content(mapper.writeValueAsString(request)))
+                    .andExpect(org.springframework.test.web.servlet.result.MockMvcResultMatchers.status().isBadRequest());
+            assertThat(engine.getRuntimeService().getVariables(processId)).isEqualTo(variableSnapshot);
+            assertThat(formTaskSnapshot(engine, processId)).isEqualTo(taskSnapshot);
+
+            authenticateFormActor("refused@insight.test", 99L);
+            request.setValues(valid);
+            mvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post("/api/internal/form/data")
+                    .contentType(org.springframework.http.MediaType.APPLICATION_JSON)
+                    .content(mapper.writeValueAsString(request)))
+                    .andExpect(org.springframework.test.web.servlet.result.MockMvcResultMatchers.status().isForbidden());
+            mvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get("/api/internal/form/data")
+                    .param("taskId", task.getId()))
+                    .andExpect(org.springframework.test.web.servlet.result.MockMvcResultMatchers.status().isForbidden());
+            assertThat(engine.getRuntimeService().getVariables(processId)).isEqualTo(variableSnapshot);
+            assertThat(formTaskSnapshot(engine, processId)).isEqualTo(taskSnapshot);
+
+            authenticateFormActor("admin@app.insight.com", 42L);
+            mvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post("/api/internal/form/data")
+                    .contentType(org.springframework.http.MediaType.APPLICATION_JSON)
+                    .content(mapper.writeValueAsString(request)))
+                    .andExpect(org.springframework.test.web.servlet.result.MockMvcResultMatchers.status().isOk());
+            assertThat(engine.getTaskService().createTaskQuery().taskId(task.getId()).count()).isZero();
+            assertThat(engine.getRuntimeService().getVariable(processId, "action_reliability")).isEqualTo("Completed");
+        } finally {
+            org.springframework.security.core.context.SecurityContextHolder.clearContext();
+            org.flowable.common.engine.impl.identity.Authentication.setAuthenticationContext(previousAuthentication);
+            engine.close();
+        }
+    }
+
+    private void authenticateFormActor(String username, Long id) {
+        var principal = new com.flatirons.insight.model.records.security.InsightUserDetails(
+                username, id, java.util.List.of(), java.util.List.of());
+        org.springframework.security.core.context.SecurityContextHolder.getContext().setAuthentication(
+                new org.springframework.security.authentication.UsernamePasswordAuthenticationToken(
+                        principal, null, java.util.List.of()));
+    }
+
+    private java.util.List<java.util.List<Object>> formTaskSnapshot(org.flowable.engine.ProcessEngine engine, String processId) {
+        return engine.getTaskService().createTaskQuery().processInstanceId(processId).list()
+                .stream().sorted(java.util.Comparator.comparing(org.flowable.task.api.Task::getId))
+                .map(task -> java.util.List.<Object>of(task.getId(), task.getName(), task.getAssignee(),
+                        task.getFormKey(), task.getTaskDefinitionKey())).toList();
+    }
+
+}
