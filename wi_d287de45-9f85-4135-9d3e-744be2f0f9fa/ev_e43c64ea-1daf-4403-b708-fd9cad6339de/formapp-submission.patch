+/**
+ * Copyright (c) 2026, Flatirons Solutions. All Rights Reserved.
+ */
+package com.flatirons.insight.service.editor;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.regex.Pattern;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.flatirons.insight.service.exception.BadRequestException;
+import org.flowable.bpmn.converter.BpmnXMLConverter;
+import org.flowable.bpmn.model.StartEvent;
+import org.flowable.bpmn.model.UserTask;
+import org.flowable.engine.RepositoryService;
+import org.flowable.engine.repository.Deployment;
+import org.springframework.stereotype.Service;
+
+/** Publishes the FormApp BPMN and its immutable, deployment-local form aliases. */
+@Service
+public class FormAppArchiveService {
+    public static final String MAPPINGS_RESOURCE = "insight-form-mappings.json";
+    private static final Pattern FORM_RESOURCE = Pattern.compile("form-models/([A-Za-z0-9_-]+)-(\\d+)\\.json");
+    private static final int MAX_ENTRY_BYTES = 8 * 1024 * 1024;
+    private static final int MAX_ARCHIVE_BYTES = 32 * 1024 * 1024;
+
+    private final RepositoryService repositoryService;
+    private final ObjectMapper objectMapper;
+
+    public FormAppArchiveService(RepositoryService repositoryService, ObjectMapper objectMapper) {
+        this.repositoryService = repositoryService;
+        this.objectMapper = objectMapper;
+    }
+
+    public Deployment deploy(InputStream archive) {
+        Map<String, byte[]> entries = readEntries(archive);
+        Map<String, byte[]> resources = new LinkedHashMap<>();
+        Map<String, String> aliases = new LinkedHashMap<>();
+        var processes = entries.entrySet().stream()
+                .filter(entry -> entry.getKey().endsWith(".bpmn20.xml")).toList();
+        if (processes.size() != 1) {
+            throw new BadRequestException("FormApp archive must contain one BPMN resource");
+        }
+        entries.forEach((name, bytes) -> addForm(name, bytes, resources, aliases));
+        byte[] bpmn = processes.getFirst().getValue();
+        validateReferences(bpmn, aliases);
+        try {
+            resources.put(MAPPINGS_RESOURCE, objectMapper.writeValueAsBytes(aliases));
+        } catch (IOException ex) {
+            throw new BadRequestException("Cannot serialize FormApp mappings", ex);
+        }
+        var builder = repositoryService.createDeployment().key("FormApp").name("FormApp");
+        resources.forEach(builder::addBytes);
+        return builder.addBytes("FormProcess.bpmn20.xml", bpmn).deploy();
+    }
+
+    private Map<String, byte[]> readEntries(InputStream archive) {
+        if (archive == null) {
+            throw new BadRequestException("A FormApp archive is required");
+        }
+        Map<String, byte[]> entries = new LinkedHashMap<>();
+        int totalBytes = 0;
+        try (ZipInputStream zip = new ZipInputStream(archive)) {
+            ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                if (entry.isDirectory()) {
+                    continue;
+                }
+                byte[] bytes = zip.readNBytes(MAX_ENTRY_BYTES + 1);
+                totalBytes += bytes.length;
+                if (bytes.length > MAX_ENTRY_BYTES || totalBytes > MAX_ARCHIVE_BYTES) {
+                    throw new BadRequestException("FormApp archive exceeds supported size");
+                }
+                if (entries.putIfAbsent(entry.getName(), bytes) != null) {
+                    throw new BadRequestException("Duplicate archive entry: " + entry.getName());
+                }
+            }
+            return entries;
+        } catch (IOException ex) {
+            throw new BadRequestException("Cannot read FormApp archive", ex);
+        }
+    }
+
+    private void addForm(String name, byte[] bytes, Map<String, byte[]> resources, Map<String, String> aliases) {
+        var match = FORM_RESOURCE.matcher(name);
+        if (!match.matches()) {
+            return;
+        }
+        JsonNode form;
+        try {
+            form = objectMapper.readTree(bytes);
+        } catch (IOException ex) {
+            throw new BadRequestException("Cannot read form resource: " + name, ex);
+        }
+        if (form == null || !form.path("editorJson").path("fields").isArray()) {
+            throw new BadRequestException("Invalid form resource: " + name);
+        }
+        String key = "FormApp/" + match.group(1);
+        if (aliases.putIfAbsent(match.group(2), key) != null
+                || resources.putIfAbsent(formResource(key), bytes) != null) {
+            throw new BadRequestException("Duplicate form alias: " + name);
+        }
+    }
+
+    public static String formResource(String key) {
+        return "forms/" + key + ".json";
+    }
+
+    private void validateReferences(byte[] bpmn, Map<String, String> aliases) {
+        var model = new BpmnXMLConverter().convertToBpmnModel(() -> new ByteArrayInputStream(bpmn), false, true);
+        if (model.getProcesses().size() != 1 || !"FormProcess".equals(model.getMainProcess().getId())) {
+            throw new BadRequestException("Only the FormApp FormProcess archive is supported");
+        }
+        for (UserTask task : model.getMainProcess().findFlowElementsOfType(UserTask.class)) {
+            requireAlias(task.getFormKey(), aliases);
+        }
+        for (StartEvent start : model.getMainProcess().findFlowElementsOfType(StartEvent.class)) {
+            if (start.getFormKey() != null && !start.getFormKey().isBlank()) {
+                requireAlias(start.getFormKey(), aliases);
+            }
+        }
+    }
+
+    private void requireAlias(String reference, Map<String, String> aliases) {
+        if (!aliases.containsKey(reference)) {
+            throw new BadRequestException("Unresolved archive form reference: " + reference);
+        }
+    }
+}
