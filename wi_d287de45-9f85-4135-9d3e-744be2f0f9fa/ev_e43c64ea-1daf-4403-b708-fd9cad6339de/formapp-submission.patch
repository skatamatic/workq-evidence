+        return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+                + "<definitions xmlns=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:activiti=\"http://activiti.org/bpmn\" targetNamespace=\"test\">"
+                + "<process id=\"" + process + "\" isExecutable=\"true\"><startEvent id=\"start\"/>"
+                + "<userTask id=\"task\" activiti:formKey=\"" + reference + "\"/></process></definitions>";
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"duplicate alias", "duplicate key", "unresolved reference", "no BPMN", "other process", "invalid form", "invalid JSON", "oversized entry", "multiple BPMN", "unresolved start reference"})
+    void invalidArchiveIsRefusedBeforeAnyDeploymentMutation(String problem) throws Exception {
+        var repository = mock(RepositoryService.class);
+        var service = new FormAppArchiveService(repository, new ObjectMapper());
+        String validForm = "{\"editorJson\":{\"fields\":[]}}";
+        var entries = new ArrayList<Entry>();
+        entries.add(new Entry("form-models/Reliability-27.json", validForm));
+        if (!"no BPMN".equals(problem)) {
+            String processXml = bpmn(
+                    "other process".equals(problem) ? "OtherProcess" : "FormProcess",
+                    "unresolved reference".equals(problem) ? "999" : "27");
+            if ("unresolved start reference".equals(problem)) {
+                processXml = processXml.replace("<startEvent id=\"start\"/>",
+                        "<startEvent id=\"start\" activiti:formKey=\"999\"/>");
+            }
+            entries.add(new Entry("FormProcess.bpmn20.xml", processXml));
+        }
+        switch (problem) {
+            case "duplicate alias" -> entries.add(new Entry("form-models/Other-27.json", validForm));
+            case "duplicate key" -> entries.add(new Entry("form-models/Reliability-28.json", validForm));
+            case "invalid form" -> entries.add(new Entry("form-models/Other-29.json", "{}"));
+            case "invalid JSON" -> entries.add(new Entry("form-models/Other-29.json", "{broken"));
+            case "oversized entry" -> entries.add(new Entry("oversized.bin", "x".repeat(8 * 1024 * 1024 + 1)));
+            case "multiple BPMN" -> entries.add(new Entry("Second.bpmn20.xml", bpmn("FormProcess", "27")));
+            default -> { }
+        }
+        var input = archive(entries);
+        assertThatThrownBy(() -> service.deploy(input)).isInstanceOf(BadRequestException.class);
+        verifyNoInteractions(repository);
+    }
+
+    @Test
+    void nullArchiveIsRefusedWithoutDeployment() {
+        var repository = mock(RepositoryService.class);
+        var service = new FormAppArchiveService(repository, new ObjectMapper());
+        assertThatThrownBy(() -> service.deploy(null)).isInstanceOf(BadRequestException.class);
+        verifyNoInteractions(repository);
+    }
+
+    @Test
+    void unreadableArchiveIsRefusedAndInputIsClosed() {
+        var repository = mock(RepositoryService.class);
+        var service = new FormAppArchiveService(repository, new ObjectMapper());
+        class UnreadableInput extends InputStream {
+            private boolean closed;
+
+            @Override
+            public int read() throws IOException {
+                throw new IOException("test read failure");
+            }
+
+            @Override
+            public void close() {
+                closed = true;
+            }
+        }
+        var input = new UnreadableInput();
+        assertThatThrownBy(() -> service.deploy(input)).isInstanceOf(BadRequestException.class)
+                .hasCauseInstanceOf(IOException.class);
+        org.assertj.core.api.Assertions.assertThat(input.closed).isTrue();
+        verifyNoInteractions(repository);
+    }
+
+}
diff --git a/insight-service/src/test/java/com/flatirons/insight/service/runtime/ArchiveFormDefinitionTest.java b/insight-service/src/test/java/com/flatirons/insight/service/runtime/ArchiveFormDefinitionTest.java
new file mode 100644
index 0000000..3e3d006
--- /dev/null
+++ b/insight-service/src/test/java/com/flatirons/insight/service/runtime/ArchiveFormDefinitionTest.java
@@ -0,0 +1,118 @@
+/**
+ * Copyright (c) 2026, Flatirons Solutions. All Rights Reserved.
+ */
+package com.flatirons.insight.service.runtime;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.flatirons.insight.service.exception.BadRequestException;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.junit.jupiter.params.provider.ValueSource;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class ArchiveFormDefinitionTest {
+    private final ObjectMapper mapper = new ObjectMapper();
+
+    private ArchiveFormDefinition form(String fields) throws Exception {
+        return new ArchiveFormDefinition(mapper.readTree("{\"editorJson\":{\"fields\":" + fields + "}}"), mapper);
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {
+            "{}",
+            "{\"editorJson\":{\"fields\":{}}}",
+            "{\"editorJson\":{\"fields\":[{\"id\":\"answer\",\"type\":\"text\"},{\"id\":\"answer\",\"type\":\"text\"}]}}",
+            "{\"editorJson\":{\"fields\":[{\"id\":\" \",\"type\":\"text\"}]}}"
+    })
+    void malformedSchemasAreRefusedBeforeTheyCanDescribeOrAcceptFields(String schema) throws Exception {
+        var parsed = mapper.readTree(schema);
+        assertThatThrownBy(() -> new ArchiveFormDefinition(parsed, mapper)).isInstanceOf(BadRequestException.class);
+    }
+
+    static Stream<Object> emptyRequiredValues() {
+        return Stream.of(null, "", "   ", List.of(), Map.of());
+    }
+
+    @ParameterizedTest
+    @MethodSource("emptyRequiredValues")
+    void missingRequiredValueCannotBeSubmitted(Object value) throws Exception {
+        var definition = form("[{\"id\":\"answer\",\"type\":\"text\",\"required\":true}]");
+        Map<String, Object> values = new LinkedHashMap<>();
+        values.put("answer", value);
+        assertThatThrownBy(() -> definition.validatedValues(values)).isInstanceOf(BadRequestException.class);
+        assertThat(values).containsKey("answer");
+        assertThatThrownBy(() -> definition.validatedValues(null)).isInstanceOf(BadRequestException.class);
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"unknown", "readOnly", "mirror"})
+    void arbitraryAndReadonlyFieldsCannotBecomeVariables(String id) throws Exception {
+        var definition = form("[{\"id\":\"readOnly\",\"type\":\"text\",\"readOnly\":true},{\"id\":\"mirror\",\"type\":\"readonly\"}]");
+        assertThatThrownBy(() -> definition.validatedValues(Map.of(id, "spoofed"))).isInstanceOf(BadRequestException.class);
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"2026-10-06", "2017-03-15T12:00:00.000Z"})
+    void acceptsLegacyInstantAndDateControlValues(String date) throws Exception {
+        var definition = form("[{\"id\":\"due\",\"type\":\"date\"}]");
+        assertThat(definition.validatedValues(Map.of("due", date))).containsEntry("due", date);
+        assertThatThrownBy(() -> definition.validatedValues(Map.of("due", "2026-02-30"))).isInstanceOf(BadRequestException.class);
+        assertThatThrownBy(() -> definition.validatedValues(Map.of("due", 20261006))).isInstanceOf(BadRequestException.class);
+    }
+
+    @Test
+    void textValuesRemainStringsAndValidatedResultDoesNotAliasRequest() throws Exception {
+        var definition = form("[{\"id\":\"answer\",\"type\":\"text\"}]");
+        var submitted = new LinkedHashMap<String, Object>();
+        submitted.put("answer", "kept");
+        var result = definition.validatedValues(submitted);
+        result.put("answer", "changed");
+        assertThat(submitted).containsEntry("answer", "kept");
+        assertThatThrownBy(() -> definition.validatedValues(Map.of("answer", 42))).isInstanceOf(BadRequestException.class);
+    }
+
+    @Test
+    void personRequiresIdentityRatherThanDisplayNameOnly() throws Exception {
+        var definition = form("[{\"id\":\"person\",\"type\":\"people\"}]");
+        assertThat(definition.validatedValues(Map.of("person", Map.of("id", 42)))).containsKey("person");
+        assertThatThrownBy(() -> definition.validatedValues(Map.of("person", Map.of("name", "Kyle")))).isInstanceOf(BadRequestException.class);
+        assertThatThrownBy(() -> definition.validatedValues(Map.of("person", "Kyle"))).isInstanceOf(BadRequestException.class);
+    }
+
+    @Test
+    void acceptsKnownOptionIdsAndRefusesPlaceholderAndUnknownChoices() throws Exception {
+        var definition = form("[{\"id\":\"action\",\"type\":\"dropdown\",\"required\":true,\"options\":[{\"id\":\"empty\",\"name\":\"Please choose one...\"},{\"id\":\"Completed\",\"name\":\"Completed\"}]}]");
+        for (Object valid : List.of("Completed", Map.of("id", "Completed"))) {
+            assertThat(definition.validatedValues(Map.of("action", valid))).containsEntry("action", valid);
+        }
+        for (Object invalid : List.of("empty", "Please choose one...", "invented", Map.of("id", "empty"), Map.of("name", "Completed"))) {
+            assertThatThrownBy(() -> definition.validatedValues(Map.of("action", invalid))).isInstanceOf(BadRequestException.class);
+        }
+    }
+
+    @Test
+    void tableRowsMustContainTheirRequiredColumn() throws Exception {
+        var definition = form("[{\"id\":\"materials\",\"type\":\"dynamic-table\",\"columnDefinitions\":[{\"id\":\"part\",\"required\":true}]}]");
+        var rows = List.of(Map.of("part", "PN-1"));
+        assertThat(definition.validatedValues(Map.of("materials", rows))).containsEntry("materials", rows);
+        for (Object invalid : List.of("not rows", List.of("not a row"), List.of(Map.of("other", "PN-1")))) {
+            assertThatThrownBy(() -> definition.validatedValues(Map.of("materials", invalid))).isInstanceOf(BadRequestException.class);
+        }
+    }
+
+    @Test
+    void exposesNestedFieldsAndReadonlyVariableWithSelectionSchemas() throws Exception {
+        var definition = form("[{\"fieldType\":\"ContainerRepresentation\",\"fields\":{\"1\":[{\"id\":\"mirror\",\"type\":\"readonly\",\"params\":{\"field\":{\"id\":\"business_value\"}}},{\"id\":\"choice\",\"type\":\"dropdown\",\"options\":[{\"id\":\"Yes\"}]},{\"id\":\"table\",\"type\":\"dynamic-table\",\"columnDefinitions\":[{\"id\":\"part\",\"required\":true}]}]}}]");
+        var responses = definition.responses(Map.of("business_value", "saved"));
+        assertThat(responses).hasSize(3);
+        assertThat(responses.getFirst().getValue()).isEqualTo("saved");
+        assertThat(responses.get(1).getOptions()).containsExactly(Map.of("id", "Yes"));
+        assertThat(responses.get(2).getColumnDefinitions()).containsExactly(Map.of("id", "part", "required", true));
+    }
+}
diff --git a/insight-rest/src/test/java/com/flatirons/insight/rest/internal/form/FormAppFormControllerTest.java b/insight-rest/src/test/java/com/flatirons/insight/rest/internal/form/FormAppFormControllerTest.java
