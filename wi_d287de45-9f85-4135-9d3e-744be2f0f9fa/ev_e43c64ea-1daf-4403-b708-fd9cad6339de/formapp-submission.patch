@@ -0,0 +1,173 @@
+/**
+ * Copyright (c) 2026, Flatirons Solutions. All Rights Reserved.
+ */
+package com.flatirons.insight.service.runtime;
+
+import java.time.LocalDate;
+import java.time.OffsetDateTime;
+import java.time.format.DateTimeParseException;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.flatirons.insight.model.response.FormFieldResponse;
+import com.flatirons.insight.service.exception.BadRequestException;
+
+/** The supported FormApp value contract; container layout does not become variables. */
+final class ArchiveFormDefinition {
+    private static final Set<String> WRITABLE_TYPES = Set.of("text", "multi-line-text", "date", "people", "dropdown", "dynamic-table");
+    private final Map<String, JsonNode> fields = new LinkedHashMap<>();
+    private final ObjectMapper objectMapper;
+
+    ArchiveFormDefinition(JsonNode form, ObjectMapper objectMapper) {
+        this.objectMapper = objectMapper;
+        JsonNode formFields = form.path("editorJson").path("fields");
+        if (!formFields.isArray()) {
+            throw new BadRequestException("Invalid deployed form fields");
+        }
+        collectFields(formFields);
+    }
+
+    private void collectFields(JsonNode nodes) {
+        for (JsonNode field : nodes) {
+            if ("ContainerRepresentation".equals(field.path("fieldType").asText())) {
+                for (JsonNode column : field.path("fields")) {
+                    collectFields(column);
+                }
+            } else {
+                String id = field.path("id").asText();
+                if (id.isBlank() || fields.putIfAbsent(id, field) != null) {
+                    throw new BadRequestException("Invalid or duplicate deployed field id: " + id);
+                }
+            }
+        }
+    }
+
+    List<FormFieldResponse> responses(Map<String, Object> variables) {
+        List<FormFieldResponse> result = new ArrayList<>();
+        fields.forEach((id, field) -> {
+            FormFieldResponse response = new FormFieldResponse();
+            response.setId(id);
+            response.setName(field.path("name").asText());
+            response.setType(field.path("type").asText());
+            response.setRequired(field.path("required").asBoolean());
+            String variable = field.path("params").path("field").path("id").asText(id);
+            Object value = variables.containsKey(variable) ? variables.get(variable)
+                    : objectMapper.convertValue(field.get("value"), Object.class);
+            response.setValue(value);
+            response.setOptions(schema(field.get("options")));
+            response.setColumnDefinitions(schema(field.get("columnDefinitions")));
+            result.add(response);
+        });
+        return result;
+    }
+
+    private List<Map<String, Object>> schema(JsonNode node) {
+        if (node == null || !node.isArray()) {
+            return List.of();
+        }
+        return objectMapper.convertValue(node, new com.fasterxml.jackson.core.type.TypeReference<>() {});
+    }
+
+    Map<String, Object> validatedValues(Map<String, Object> submitted) {
+        Map<String, Object> values = submitted == null ? Map.of() : new LinkedHashMap<>(submitted);
+        for (String id : values.keySet()) {
+            JsonNode field = fields.get(id);
+            if (field == null || !writable(field)) {
+                throw new BadRequestException("Unknown or read-only form field: " + id);
+            }
+        }
+        fields.forEach((id, field) -> {
+            Object value = values.get(id);
+            if (field.path("required").asBoolean() && empty(value)) {
+                throw new BadRequestException("Required form field: " + id);
+            }
+            if (values.containsKey(id) && !empty(value)) {
+                validateValue(id, field, value);
+            }
+        });
+        // Return only submitted, declared field IDs: no arbitrary process-variable writes.
+        return values;
+    }
+
+    private boolean writable(JsonNode field) {
+        return !field.path("readOnly").asBoolean() && WRITABLE_TYPES.contains(field.path("type").asText());
+    }
+
+    private void validateValue(String id, JsonNode field, Object value) {
+        switch (field.path("type").asText()) {
+            case "dropdown" -> validateOption(id, field, value);
+            case "dynamic-table" -> validateTable(id, field, value);
+            case "date" -> validateDate(id, value);
+            case "people" -> {
+                if (!(value instanceof Map<?, ?> person) || empty(person.get("id"))) {
+                    throw new BadRequestException("Expected a person with an id for: " + id);
+                }
+            }
+            case "text", "multi-line-text" -> {
+                if (!(value instanceof String)) {
+                    throw new BadRequestException("Expected text for: " + id);
+                }
+            }
+        }
+    }
+
+    private void validateDate(String id, Object value) {
+        if (value instanceof String date) {
+            try {
+                LocalDate.parse(date);
+                return;
+            } catch (DateTimeParseException ex) {
+                // Legacy date controls submit an ISO instant; date-only controls are also supported.
+            }
+            try {
+                OffsetDateTime.parse(date);
+                return;
+            } catch (DateTimeParseException ex) {
+                throw new BadRequestException("Expected an ISO date for: " + id);
+            }
+        }
+        throw new BadRequestException("Expected an ISO date for: " + id);
+    }
+
+    private void validateOption(String id, JsonNode field, Object value) {
+        Object selected = value instanceof Map<?, ?> option ? option.get("id") : value;
+        if (!(selected instanceof String selectedId) || "empty".equals(selectedId)) {
+            throw new BadRequestException("Invalid form option: " + id);
+        }
+        for (JsonNode option : field.path("options")) {
+            if (selectedId.equals(option.path("id").asText())) {
+                return;
+            }
+        }
+        throw new BadRequestException("Invalid form option: " + id);
+    }
+
+    private void validateTable(String id, JsonNode field, Object value) {
+        if (!(value instanceof List<?> rows)) {
+            throw new BadRequestException("Expected table rows for: " + id);
+        }
+        for (Object rowValue : rows) {
+            if (!(rowValue instanceof Map<?, ?> row)) {
+                throw new BadRequestException("Expected a table row for: " + id);
+            }
+            for (JsonNode column : field.path("columnDefinitions")) {
+                String columnId = column.path("id").asText();
+                if (column.path("required").asBoolean() && empty(row.get(columnId))) {
+                    throw new BadRequestException("Required table column: " + id + "." + columnId);
+                }
+            }
+        }
+    }
+
+    private static boolean empty(Object value) {
+        return value == null || value instanceof String text && text.isBlank()
+                || value instanceof Collection<?> collection && collection.isEmpty()
+                || value instanceof Map<?, ?> map && map.isEmpty();
+    }
+}
