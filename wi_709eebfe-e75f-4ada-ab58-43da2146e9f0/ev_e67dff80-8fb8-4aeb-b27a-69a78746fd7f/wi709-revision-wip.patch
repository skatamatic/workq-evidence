@@ -0,0 +1,96 @@
+/** Copyright (c) 2026, Flatirons Solutions. All Rights Reserved. */
+package com.flatirons.insight.service.runtime;
+
+import java.util.List;
+import com.flatirons.insight.domain.UserEntity;
+import com.flatirons.insight.domain.GroupEntity;
+import com.flatirons.insight.model.UserDto;
+import com.flatirons.insight.model.enums.status.UserAccountStatus;
+import com.flatirons.insight.model.enums.status.GroupStatus;
+import com.flatirons.insight.model.enums.type.GroupType;
+import com.flatirons.insight.model.response.IGroupResponse;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.*;
+
+class WorkflowTaskIdentityServiceTest {
+    private final UserService users = mock(UserService.class);
+    private final GroupService groups = mock(GroupService.class);
+    private final WorkflowTaskIdentityService identities = new WorkflowTaskIdentityService(users, groups);
+
+    @ParameterizedTest
+    @ValueSource(strings = {"", " "})
+    void blankUserRefusesWithoutIdentityLookup(String input) {
+        assertThatThrownBy(() -> identities.user(input)).isInstanceOf(IllegalArgumentException.class);
+        verifyNoInteractions(users, groups);
+    }
+
+    @Test
+    void malformedPersistedUserRefusesInsteadOfDevelopmentFallback() {
+        UserDto dto = new UserDto();
+        when(users.findUserByUsername("broken")).thenReturn(dto);
+        assertThatThrownBy(() -> identities.user("broken")).isInstanceOf(IllegalArgumentException.class);
+        dto.setId(0L);
+        assertThatThrownBy(() -> identities.user("broken")).isInstanceOf(IllegalArgumentException.class);
+        dto.setId(3L);
+        assertThatThrownBy(() -> identities.user("broken")).isInstanceOf(IllegalArgumentException.class);
+        dto.setUserName("active"); dto.setAccountStatus(UserAccountStatus.INACTIVE);
+        assertThatThrownBy(() -> identities.user("broken")).isInstanceOf(IllegalArgumentException.class);
+        dto.setAccountStatus(UserAccountStatus.ACTIVE);
+        assertThat(identities.user("broken")).isSameAs(dto);
+        verifyNoInteractions(groups);
+    }
+
+    @Test
+    void candidateGroupMustMatchActiveFunctionalPersistedIdentity() {
+        assertThatThrownBy(() -> identities.group("not-an-id")).isInstanceOf(IllegalArgumentException.class);
+        verifyNoInteractions(groups);
+        IGroupResponse dto = mock(IGroupResponse.class);
+        when(groups.getGroup(7L)).thenReturn(dto);
+        when(dto.getId()).thenReturn("8");
+        assertThatThrownBy(() -> identities.group("7")).isInstanceOf(IllegalArgumentException.class);
+        when(dto.getId()).thenReturn("7"); when(dto.getStatus()).thenReturn("INACTIVE");
+        assertThatThrownBy(() -> identities.group("7")).isInstanceOf(IllegalArgumentException.class);
+        when(dto.getStatus()).thenReturn("ACTIVE"); when(dto.getType()).thenReturn(GroupType.ROLE);
+        assertThatThrownBy(() -> identities.group("7")).isInstanceOf(IllegalArgumentException.class);
+        when(dto.getType()).thenReturn(GroupType.GROUP);
+        assertThat(identities.group("7")).isEqualTo("7");
+    }
+
+    @Test
+    void missingOrInactiveMembershipOwnerRefuses() {
+        assertThatThrownBy(() -> identities.memberships(1L)).isInstanceOf(IllegalArgumentException.class);
+        UserEntity user = new UserEntity(); user.setAccountStatus(UserAccountStatus.INACTIVE);
+        when(users.getUserEntity(1L, true)).thenReturn(user);
+        assertThatThrownBy(() -> identities.memberships(1L)).isInstanceOf(IllegalArgumentException.class);
+        verifyNoInteractions(groups);
+    }
+
+    @Test
+    void absentAndNonfunctionalMembershipsGrantNothing() {
+        UserEntity user = new UserEntity(); user.setAccountStatus(UserAccountStatus.ACTIVE);
+        user.setGroups(null); when(users.getUserEntity(1L, true)).thenReturn(user);
+        assertThat(identities.memberships(1L)).isEmpty();
+        GroupEntity inactive = new GroupEntity(); inactive.setGroupType(GroupType.GROUP);
+        GroupEntity role = new GroupEntity(); role.setStatus(GroupStatus.ACTIVE); role.setGroupType(GroupType.ROLE);
+        user.setGroups(List.of(inactive, role));
+        assertThat(identities.memberships(1L)).isEmpty();
+        verifyNoInteractions(groups);
+    }
+
+    @Test
+    void inactiveOrRoleParentCannotGrantAncestorMembership() {
+        UserEntity user = new UserEntity(); user.setAccountStatus(UserAccountStatus.ACTIVE);
+        GroupEntity membership = new GroupEntity(); membership.setId(7L);
+        membership.setStatus(GroupStatus.ACTIVE); membership.setGroupType(GroupType.GROUP);
+        user.setGroups(List.of(membership)); when(users.getUserEntity(1L, true)).thenReturn(user);
+        IGroupResponse parent = mock(IGroupResponse.class); when(groups.getGroup(7L)).thenReturn(parent);
+        when(parent.getStatus()).thenReturn("INACTIVE");
+        assertThat(identities.memberships(1L)).isEmpty();
+        when(parent.getStatus()).thenReturn("ACTIVE"); when(parent.getType()).thenReturn(GroupType.ROLE);
+        assertThat(identities.memberships(1L)).isEmpty();
+    }
+}
