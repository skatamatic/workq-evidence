+    private void addActiveAncestors(Long groupId, Set<String> result) {
+        Set<Long> visited = new HashSet<>();
+        Long next = groupId;
+        while (next != null) {
+            if (!visited.add(next)) {
+                throw new IllegalArgumentException("Cyclic task group hierarchy");
+            }
+            var group = groups.getGroup(next);
+            if (group == null || !"ACTIVE".equals(group.getStatus()) || group.getType() != GroupType.GROUP) {
+                return;
+            }
+            result.add(group.getId());
+            next = group.getParentGroupId();
+        }
