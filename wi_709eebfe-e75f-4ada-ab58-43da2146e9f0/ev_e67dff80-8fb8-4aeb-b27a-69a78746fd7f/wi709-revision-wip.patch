diff --git a/insight-service/src/test/java/com/flatirons/insight/service/runtime/WorkflowTaskIdentityServiceTest.java b/insight-service/src/test/java/com/flatirons/insight/service/runtime/WorkflowTaskIdentityServiceTest.java
