+/** Copyright (c) 2026, Flatirons Solutions. All Rights Reserved. */
+package com.flatirons.insight.service.runtime.listener;
+
+import java.util.Date;
+import org.flowable.engine.delegate.DelegateExecution;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+import static org.mockito.Mockito.verifyNoInteractions;
+
+class TaskDueDateBeanTest {
+    private final TaskDueDateBean bean = new TaskDueDateBean();
+    private final DelegateExecution execution = mock(DelegateExecution.class);
+
+    @Test
+    void dateValueIsCopiedAndEmptyValueClearsDueDate() {
+        Date input = new Date(123456789L);
+        when(execution.getVariable("critical_date")).thenReturn(input, "", null);
+        Date result = bean.calculateDueDateWithField("critical_date", "add", 0, 0, 0, 0, 0, 0, execution);
+        assertThat(result).isEqualTo(input).isNotSameAs(input);
+        result.setTime(0);
+        assertThat(input.getTime()).isEqualTo(123456789L);
+        assertThat(bean.calculateDueDateWithField("critical_date", "add", 0, 0, 0, 0, 0, 0, execution)).isNull();
+        assertThat(bean.calculateDueDateWithField("critical_date", "add", 0, 0, 0, 0, 0, 0, execution)).isNull();
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"unknown", "", "critical_date_extra"})
+    void unsupportedFieldsRefuseBeforeReadingProcessState(String field) {
+        assertThatThrownBy(() -> bean.calculateDueDateWithField(field, "add", 0, 0, 0, 0, 0, 0, execution))
+                .isInstanceOf(IllegalArgumentException.class);
+        verifyNoInteractions(execution);
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"subtract", "businessDays", ""})
+    void unsupportedOperationsRefuseBeforeReadingProcessState(String operation) {
+        assertThatThrownBy(() -> bean.calculateDueDateWithField("critical_date", operation, 0, 0, 0, 0, 0, 0, execution))
+                .isInstanceOf(IllegalArgumentException.class);
+        verifyNoInteractions(execution);
+    }
+
+    @Test
+    void eachCalendarOffsetAndMalformedArgumentListRefusesBeforeReadingProcessState() {
+        for (int index = 0; index < 6; index++) {
+            Object[] offsets = {0, 0, 0, 0, 0, 0, execution};
+            offsets[index] = 1;
+            assertThatThrownBy(() -> bean.calculateDueDateWithField("critical_date", "add", offsets))
+                    .isInstanceOf(IllegalArgumentException.class);
+        }
+        assertThatThrownBy(() -> bean.calculateDueDateWithField("critical_date", "add", 0, 0, 0))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> bean.calculateDueDateWithField("critical_date", "add", (Object[]) null))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> bean.calculateDueDateWithField("critical_date", "add", 0, 0, 0, 0, 0, 0, "execution"))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> bean.calculateDueDateWithField("critical_date", "add", "0", 0, 0, 0, 0, 0, execution))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> bean.calculateDueDateWithField("critical_date", "add",
+                new java.math.BigDecimal("1e-999"), 0, 0, 0, 0, 0, execution))
+                .isInstanceOf(IllegalArgumentException.class);
+        verifyNoInteractions(execution);
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"31-02-2026", "01-13-2026", "1-01-2026", "12-01-2026 trailing"})
+    void invalidCalendarDateRefuses(String value) {
+        when(execution.getVariable("analyst_due_date")).thenReturn(value);
+        assertThatThrownBy(() -> bean.calculateDueDateWithVariable("analyst_due_date", "add", 0, 0, 0, 0, 0, 0, execution))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+}
