+package com.flatirons.insight.service.runtime.listener;
+
+import java.util.List;
+import com.flatirons.insight.service.runtime.WorkflowTaskIdentityService;
+import org.flowable.engine.HistoryService;
+import org.flowable.engine.delegate.DelegateExecution;
+import org.flowable.engine.history.HistoricProcessInstance;
+import org.flowable.engine.history.HistoricProcessInstanceQuery;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.*;
+
+class TaskAssignmentBeanTest {
+    private final WorkflowTaskIdentityService identities = mock(WorkflowTaskIdentityService.class);
+    private final HistoryService history = mock(HistoryService.class);
+    private final DelegateExecution execution = mock(DelegateExecution.class);
+    private final TaskAssignmentBean bean = new TaskAssignmentBean(identities, history);
+
+    @ParameterizedTest
+    @ValueSource(strings = {"manager()", "field(broken", "broken)", ",", " "})
+    void unsupportedCandidateExpressionRefusesOrYieldsNoGroups(String expression) {
+        if (expression.isBlank()) {
+            assertThat(bean.assignTaskToCandidateGroups(expression, execution)).isEmpty();
+        } else {
+            assertThatThrownBy(() -> bean.assignTaskToCandidateGroups(expression, execution))
+                    .isInstanceOf(IllegalArgumentException.class);
+        }
+        verifyNoInteractions(identities, history);
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"", " "})
+    void emptyAssigneeFieldRefusesBeforeProcessVariableRead(String field) {
+        assertThatThrownBy(() -> bean.assignTaskToAssignee(field, execution)).isInstanceOf(IllegalArgumentException.class);
+        verifyNoInteractions(execution, identities, history);
+    }
+
+    @Test
+    void absentCandidateFieldIsNotConvertedIntoGroupIdentity() {
+        assertThat(bean.assignTaskToCandidateGroups(null, execution)).isEmpty();
+        assertThat(bean.assignTaskToCandidateGroups("field(missing)", execution)).isEmpty();
+        verifyNoInteractions(identities, history);
+    }
+
+    @Test
+    void structuredAssignmentFieldRefusesBeforeIdentityLookup() {
+        when(execution.getVariable("assignee")).thenReturn(List.of("1"));
+        assertThatThrownBy(() -> bean.assignTaskToAssignee("assignee", execution)).isInstanceOf(IllegalArgumentException.class);
+        verifyNoInteractions(identities, history);
+    }
+
+    @Test
+    void absentHistoricInstanceOrStarterCannotBecomeFallbackAssignee() {
+        HistoricProcessInstanceQuery query = mock(HistoricProcessInstanceQuery.class);
+        when(history.createHistoricProcessInstanceQuery()).thenReturn(query);
+        when(execution.getProcessInstanceId()).thenReturn("process");
+        when(query.processInstanceId("process")).thenReturn(query);
+        assertThatThrownBy(() -> bean.assignTaskToAssignee("assignee", execution)).isInstanceOf(IllegalArgumentException.class);
+        HistoricProcessInstance instance = mock(HistoricProcessInstance.class);
+        when(query.singleResult()).thenReturn(instance);
+        assertThatThrownBy(() -> bean.assignTaskToCandidateUsers(null, execution)).isInstanceOf(IllegalArgumentException.class);
+        verifyNoInteractions(identities);
+    }
+}
